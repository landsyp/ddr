e">Member # :</label>										<input class="w-input champtexte" data-name="nomembre" id="nomembre" maxlength="30" name="nomembre"  type="text" value="<cfoutput>#nomembre#</cfoutput>">										</div>									</div>									<div class="blocchamp">											<label class="labeldechamp" for="securite">Security (enter result of 50+20) :</label>											<!--- <input class="w-input champtexte" data-name="securite" id="securite" maxlength="10" name="securite"  type="text" value=""> --->											<input class="w-input champtexte" data-name="securite" id="securite" maxlength="30" name="securite" required=""  type="text" value=""  pattern="[a-zA-Z0-9áàâäãåçéèêëíìîïñóòôöõúùûüýÿæœÁÀÂÄÃÅÇÉÈÊËÍÌÎÏÑÓÒÔÖÕÚÙÛÜÝŸÆŒ._-\s]+" oninvalid="setCustomValidity('Enter the result of the security question')" onchange="try{setCustomValidity('')}catch(e){}">										</div>									<div class="blocchamp blocchamppleinelargeur doubleseparateur"></div>																	<div class="blocchamp blocchamppleinelargeur">										<input class="w-button boutonvalider" data-wait="Registration in process" type="submit" name="ajout" value="Subscribe" wait="Registration in process">									</div>								</cfform>							</CFIF>        				</div><div class="w-form">      			</div><!--- <div class="blocfondblanc"> --->    			</div><!--- <div class="w-container containerprincipal"> --->  			</div>		  			<CFINCLUDE TEMPLATe="_footer.inc">					<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.0/jquery.min.js"></script>			<script type="text/javascript" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/js/webflow.js"></script>			<!--[if lte IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->			</body>	</html>	<CFCATCH>				<CFINCLUDE TEMPLATE="_envoi_erreur.inc"> 		<CFIF Session.langue EQ "fr">			<CFLOCATION URL="#APPLICATION.Racine#/fr/erreur" ADDTOKEN="NO">		<CFELSE>			<CFLOCATION 