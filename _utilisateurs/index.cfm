<CFTRY>		<CFSET VARIABLES.title_fr = "DDR ACCUEIL">	<CFSET file_name_fr = "#APPLICATION.Racine#/fr/secure/accueil">	<CFSET VARIABLES.title_en = "DDR HOME">	<CFSET file_name_en = "#APPLICATION.Racine#/en/secure/home">			<!DOCTYPE html>	<!-- This site was created in Webflow. http://www.webflow.com-->	<!-- Last Published: Thu Jun 16 2016 16:27:16 GMT+0000 (UTC) -->	<html data-wf-site="5718896fb6f10eb45d8c7872" data-wf-page="571e1ada86c1049c4c1021f7">	<head>		<CFINCLUDE TEMPLATe="../_head.inc">	</head>	<body class="stylebody">		<CFINCLUDE TEMPLATe="_menu.inc">				<CFIF Session.langue EQ "fr">		<div class="w-section sectionsousheader">  			<div class="w-container containersousheader">	 			<div class="wrappersousheader">					<h3 class="headingbreadcrumb">Bienvenue <cfoutput>#Session.utilisateur.prenom# #Session.utilisateur.nom# (#Session.utilisateur.organisme#)</cfoutput> </h3>						 			</div>  			</div>		</div>		<div class="w-section sectioncontenuprincipal">			<!--- SI UTILISATEUR SUPRA ADMIN DU CQOC ON AFFICHE LA LISTE DES ORGANISMES A SELECTIONNER POUR DEVENIR UN UTILISATEUR DE L'UNE D'ELLE  --->			<CFIF Session.utilisateur.supraAdmin>				<CFIF isdefined('organismeID')>										<cfinvoke component="#APPLICATION.cfcUtilisateurs#" method = "organismeInfos" returnvariable ="organisme">						<cfinvokeargument name="organismeID" value="#Form.organismeID#">					</cfinvoke>					<CFSET Session.utilisateur.organismeID = Form.organismeID>					<CFSET Session.utilisateur.organisme = organisme.organisme>				</CFIF>				<cfinvoke component="#APPLICATION.cfcAdmin#" method = "organismesListe" returnvariable ="organismes"/>				<div class="w-container containerprincipal">					<div class="blocfondblanc">					<CFFORM  class="blocformulaireajouterdon" method="POST" action="#file_name_fr#" data-name="Changer organisme" id="wf-form-changer-organisme" name="wf-form-changer-organisme">					<select class="w-select " data-name="organismeID" id="organismeID" name="organismeID" onchange="this.form.submit()">						<option value="0">-- S&Eacute;LECTION CLIENT -- </option>						<cfoutput query="organismes"><option value="#organismeID#" <CFIF NOT actif>STYLE="color:##BBB;"</CFIF> <CFIF organismeID EQ Session.utilisateur.organismeID>SELECTED</CFIF>>#organisme# <cfif interne and organismeID NEQ 0>(interne)</cfif></option></CFOUTPUT>												</select>					</CFFORM>					</div>				</div>			</CFIF> 			<div class="w-container containerprincipal">	 			<div class="blocfondblanc"><img height="100" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/iconmonstr-coin-6.svg">					<h3 class="h3boite">Dons</h3>					<div class="containerliens">		  				<ul class="ulliens">			 				<!--- ADMIN - NIVEAUX 2 ET 5 --->							<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/ajout-don">Ajouter un don</a></li>			 				<!--- ADMIN - NIVEAU 2 --->							<CFIF listFind("0,1,2",Session.utilisateur.statut)>								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/import-dons-lot">Import de dons</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/liste-des-dons/page-1">Liste des dons</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/ajout-compte">Ajouter un compte</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/liste-des-comptes/page-1">Liste des comptes</a></li>							</CFIF>						</ul>					</div> 	 			</div>  				<!--- ADMIN - NIVEAU 2 --->				<CFIF isDefined('Session.utilisateur.statut') AND listFind("0,1,2",Session.utilisateur.statut)>					<div class="blocfondblanc"><img height="100" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/iconmonstr-user-29.svg">						<h3 class="h3boite">Donateurs</h3>						<div class="containerliens">							<ul class="ulliens">								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/ajout-donateur">Ajouter un donateur</a>								</li>								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/import-donateurs-lot">Import de donateurs</a>								</li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/liste-des-donateurs/page-1">Liste des donateurs</a>								</li>							</ul>						</div>					</div>				</CFIF>				<!--- ADMIN - NIVEAU 2 --->				<CFIF isDefined('Session.utilisateur.statut') AND listFind("0,1,2",Session.utilisateur.statut)>					<div class="blocfondblanc"><img height="100" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/iconmonstr-note-18.svg">						<h3 class="h3boite">Rapports</h3>						<div class="containerliens">							<ul class="ulliens">								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/bordereau-depot">Bordereau de d&eacute;p&ocirc;t</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/rapport-dons">Dons (d&eacute;taill&eacute;)</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/rapport-dons-sommaire">Dons (sommaire)</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/rapport-donateurs">Donateurs</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/rapport-comptes">Comptes</a></li>								<!--- ADMIN SEULEMENT --->								<!--- <CFIF Session.utilisateur.statut EQ 1>									<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/rapport-recus">Reçus pour fin d'imp&ocirc;t</a></li>								</CFIF> --->							</ul>						</div>					</div>				</CFIF>								<!--- ADMIN SEULEMENT --->				<CFIF isDefined('Session.utilisateur.statut') AND listFind("0,1",Session.utilisateur.statut)>					<div class="blocfondblanc"><img height="100" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/recu.png">						<h3 class="h3boite">Re&ccedil;us imp&ocirc;t</h3>						<div class="containerliens">							<ul class="ulliens">								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/rapport-recus">Impression (pdf)</a></li>								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/generateur-recus-courriels">Envoi courriel </a></li>								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/liste-des-envois/page-1">Rapports envois courriel</a></li>							</ul>						</div>					</div>				</CFIF>   			</div>		</div>	<CFELSE>		<div class="w-section sectionsousheader">  			<div class="w-container containersousheader">	 			<div class="wrappersousheader">					<h3 class="headingbreadcrumb">Welcome <cfoutput>#Session.utilisateur.prenom# #Session.utilisateur.nom#</cfoutput></h3>	 			</div>  			</div>		</div>		<div class="w-section sectioncontenuprincipal">			<!--- SI UTILISATEUR SUPRA ADMIN DU CQOC ON AFFICHE LA LISTE DES ORGANISMES A SELECTIONNER POUR DEVENIR UN UTILISATEUR DE L'UNE D'ELLE  --->			<CFIF Session.utilisateur.supraAdmin>				<CFIF isdefined('organismeID')>					<CFSET Session.utilisateur.organismeID = Form.organismeID>				</CFIF>				<cfinvoke component="#APPLICATION.cfcAdmin#" method = "organismesListe" returnvariable ="organismes"/>				<div class="w-container containerprincipal">					<div class="blocfondblanc">					<CFFORM  class="blocformulaireajouterdon" method="POST" action="#file_name_fr#" data-name="Changer organisme" id="wf-form-changer-organisme" name="wf-form-changer-organisme">					<select class="w-select " data-name="organismeID" id="organismeID" name="organismeID" onchange="this.form.submit()">						<option value="0">-- SELECT CLIENT -- </option>						<cfoutput query="organismes"><option value="#organismeID#" <CFIF organismeID EQ Session.utilisateur.organismeID>SELECTED</CFIF>>#organisme# <cfif interne and organismeID NEQ 0>(internal)</cfif></option></CFOUTPUT>												</select>					</CFFORM>					</div>				</div> 			</CFIF> 			<div class="w-container containerprincipal">	 			<div class="blocfondblanc"><img height="100" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/iconmonstr-coin-6.svg">					<h3 class="h3boite">Gifts</h3>					<div class="containerliens">		  				<ul class="ulliens">							<!--- ADMIN - NIVEAUX 2 ET 5 --->			 				<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/add-gift">Add a gift</a></li>			 				<!--- ADMIN - NIVEAU 2 --->							<CFIF listFind("0,1,2",Session.utilisateur.statut)>								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/gifts-batch-import">Gifts Import (Excel)</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/gifts-list/page-1">Gifts' List</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/add-account">Add an account</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/accounts-list/page-1">Accounts' List</a></li>							</CFIF>						</ul>					</div>	 			</div>				<!--- ADMIN - NIVEAU 2 --->				<CFIF isDefined('Session.utilisateur.statut') AND listFind("0,1,2",Session.utilisateur.statut)>					<div class="blocfondblanc"><img height="100" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/iconmonstr-user-29.svg">						<h3 class="h3boite">Donors</h3>						<div class="containerliens">							<ul class="ulliens">								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/add-donor">Add a donor</a>								</li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/donors-list/page-1">Donors' List</a>								</li>							</ul>						</div>					</div>				</CFIF>				<!--- ADMIN - NIVEAU 2 --->				<CFIF isDefined('Session.utilisateur.statut') AND listFind("0,1,2",Session.utilisateur.statut)>					<div class="blocfondblanc"><img height="100" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/iconmonstr-note-18.svg">						<h3 class="h3boite">Reports</h3>						<div class="containerliens">							<ul class="ulliens">								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/deposit-slip">Deposit Slip</a></li> 								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/report-gifts">Gifts (Detailed)</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/report-gifts-summary">Gifts (Summary)</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/report-donors">Donors</a></li>								<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/report-accounts">Accounts</a></li>								<!--- <CFIF Session.utilisateur.statut EQ 1>									<li><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/report-receipts">Receipts for Income Tax</a></li>								</CFIF> --->							</ul>						</div>					</div>				</CFIF>				<!--- ADMIN SEULEMENT --->				<CFIF isDefined('Session.utilisateur.statut') AND listFind("0,1",Session.utilisateur.statut)>					<div class="blocfondblanc"><img height="100" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/recu.png">						<h3 class="h3boite">Tax Receipts</h3>						<div class="containerliens">							<ul class="ulliens">								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/report-receipts">Printing (pdf)</a></li>								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/receipts-email-generator">Emailing</a></li>								<li class="ulliens"><a class="lienbleu" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/bulk-emails-list/page-1">Email Reports</a></li>							</ul>						</div>					</div>				</CFIF>  			</div>		</div>	</CFIF>		<CFINCLUDE TEMPLATe="../_footer.inc">		<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.0/jquery.min.js"></script>	<script type="text/javascript" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/js/webflow.js"></script>	<!--[if lte IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->	</body>			</html>	<CFCATCH>		<CFINCLUDE TEMPLATE="../_envoi_erreur.inc"> 		<CFIF Session.langue EQ "fr">			<CFLOCATION URL="#APPLICATION.Racine#/fr/erreur" ADDTOKEN="NO">		<CFELSE>			<CFLOCATION URL="#APPLICATION.Racine#/en/error" ADDTOKEN="NO">		</CFIF>	</CFCATCH></CFTRY>