="#APPLICATION.Racine#/fr/secure/editer-compte-#compteID#">## #noCompte#</a></div>          					<div class="itemligne">#nom#</div>          					<div class="itemligne"><cfif recu>oui<cfelse>non</cfif></div>          					<div class="editerligne">            					<a class="w-inline-block lientableau" href="#APPLICATION.Racine#/fr/secure/editer-compte-#compteID#"><img class="iconetableau" src="/images/iconmonstr-pencil-4.svg" width="14" TITLE="Modifier">            					</a>            					<a class="w-inline-block lientableau" href="##" onClick="blocking('#compteID#'); return false;"><img class="iconetableau" src="#APPLICATION.Racine#/images/iconmonstr-x-mark-1.svg" width="14" TITLE="Supprimer">									</a>																			<!--- 	<a class="w-inline-block lientableau" data-ix="show-confirmation-deleting" href="#APPLICATION.Racine#/fr/secure/supprimer-compte-#compteID#" onClick="blocking('#compteID#'); return false;"><img class="iconetableau" src="/images/iconmonstr-x-mark-1.svg" width="14" TITLE="Supprimer">																		</a> --->            					          					</div>          				</div>							<div class="lignesuppressiondon" id="#compteID#" style="display: none">								<div class="texteblanc">Confirmez-vous la supression du compte de ## #noCompte# ?</div><a class="w-button boutonsupression" href="#APPLICATION.Racine#/fr/secure/supprimer-compte-#compteID#">OUI</a><a class="w-button boutonsupression" data-ix="hide-delete-message" href="##">NON</a>							</div>        					        					</cfoutput>        			        					<div class="blockpagination">        						<cfloop index="page" from="1" to="#nbrePages#">		 							<a class="w-inline-block blocklienpagination" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/secure/liste-des-comptes/page-<cfoutput>#page#</cfoutput>">										<div class="numeropage" <cfif page EQ URL.page>STYLE="font-size:18px;font-weight:bold;"</CFIF>><cfoutput>#page#</cfoutput></div>		 							</a>		 						</cfloop>		        					</div>        				<CFELSE>        					<div class="lignedetableau headertableau">          					<div class="itemligne itemdate"><strong>Account #</strong></div>          					<div class="itemligne"><strong>Name</strong></div>          					<div class="itemligne"><strong>Issue receipt</strong></div>          				          					<div class="editerligne"></div>        					</div>        			       					<cfoutput query="liste" startRow=#premierCompte# maxrows=#comptesParPage#>        					        					<div class="lignedetableau" >        					          					<div class="itemligne itemdate"><a class="w-inline-block lientableau" href="#APPLICATION.Racine#/en/secure/edit-account-#compteID#">## #noCompte#</a></div>          					<div class="itemligne">#nom#</div>          					<div class="itemligne"><cfif recu>yes<cfelse>no</cfif></div>          					<div class="editerligne">            					<a class="w-inline-block lientableau" href="#APPLICATION.Racine#/en/secure/edit-account-#compteID#"><img class="iconetableau" src="/images/iconmonstr-pencil-4.svg" width="14" TITLE="Edit">            					</a>            					<a class="w-inline-block lientableau" href="##" onClick="blocking('#compteID#'); return false;"><img class="iconetableau" src="#APPLICATION.Racine#/images/iconmonstr-x-mark-1.svg" width="14" TITLE="Delete">									</a>																			<!--- 	<a class="w-inline-block lientableau" data-ix="show-confirmation-deleting" href="#APPLICATION.Racine#/fr/secure/supprimer-compte-#compteID#" onClick="blocking('#compteID#'); return false;"><img class="iconetableau" src="/images/iconmonstr-x-mark-1.svg" width="14" TITLE="Supprimer">																		</a> --->            					          					</div>          				</div>							<div class="lignesuppressiondon" id="#compteID#" style="display: none">								<div class="texteblanc">Confirm deletion of account ## #noCompte# ?</div><a class="w-button boutonsupression" href="#APPLICATION.Racine#/en/secure/delete-account-#compteID#">YES</a><a class="w-button boutonsupression" data-ix="hide-delete-message" href="##">NO</a>							</div>        					        					</cfoutput>        			        					<div class="blockpagination">        						<cfloop index="page" from="1" to="#nbrePages#">		 							<a class="w-inline-block blocklienpagination" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/secure/accounts-list/page-<cfoutput>#page#</cfoutput>">										<div class="numeropage" <cfif page EQ URL.page>STYLE="font-size:18px;font-weight:bold;"</CFIF>><cfoutput>#page#</cfoutput></div>		 							</a>		 						</cfloop>		        					</div>        				</CFIF>      			</div>    			</div>  			</div>		  			<CFINCLUDE TEMPLATe="../_footer.inc">					<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.0/jquery.min.js"></script>			<script type="text/javascript" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/js/webflow.js"></script>			<!--[if lte IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->			</body>	</html>	<CFCATCH>				<CFINCLUDE TEMPLATE="../_envoi_erreur.inc"> 		<CFIF Session.langue EQ "fr">			<CFLOCATION URL="#APPLICATION.Racine#/fr/erreur" ADDTOKEN="NO">		<CFELSE>			<CFLOCATION URL="#APPLICATION.Racine#/en/error" ADDTOKEN="NO">		</CFIF>		<!--- <cfoutput>					#DateFormat(now(),"DD MMMM, YYYY")# #TimeFormat(now(),"(HH:MM:SS)")#<br>					Une erreur est survenue sur DDR					<BR>					<CFIF isDefined('Session.utilisateur.prenom')>					Utilisateur : #Session.utilisateur.prenom# #Session.utilisateur.nom# <BR>					</CFIF>					<cfif IsDefined('cfcatch')> Message : #cfcatch.Message#<BR></CFIF>																	<cfif IsDefined('cfcatch')><cfdump var="#cfcatch#" label="cfcatch"></cfif>					<HR>					<cfdump var="#Form#" label="Form Variables">					<HR>					<cfdump var="#URL#" label="URL Variables">					<HR>					<cfdump var="#session#" label="Session Variables">				</cfoutput> --->			</CFCATCH></CFTRY>