<CFTRY>	<CFSET VARIABLES.title_en = "DDR ACCOUNTS LIST">	<CFSET file_name_en = "#APPLICATION.Racine#/en/secure/accounts-list/page-1">	<CFSET VARIABLES.title_fr = "DDR LISTE DES COMPTES">	<CFSET file_name_fr = "#APPLICATION.Racine#/fr/secure/liste-des-comptes/page-1">		<CFParam name="URL.page" default="1">		<CFSET Session.message="">	<CFSET Session.messageEchec="">	<CFIF isDefined('URL.supprimerCID')>		<cfinvoke component="#APPLICATION.cfcComptes#" method ="compteSupprimer" returnvariable ="message">			<cfinvokeargument name="compteID" value="#URL.supprimerCID#">		</cfinvoke>	</CFIF>	<cfinvoke component="#APPLICATION.cfcComptes#" method = "comptesListe" returnvariable ="liste">		<cfinvokeargument name="organismeID" value="#Session.utilisateur.organismeID#">			</cfinvoke>		<cfset comptesParPage = 25>	<cfset premierCompte = ((URL.page-1)*comptesParPage)+1>	<cfset nbrePages = Ceiling(liste.recordcount/comptesParPage)>	<!DOCTYPE html>	<!-- This site was created in Webflow. http://www.webflow.com-->	<!-- Last Published: Thu Jun 16 2016 16:27:16 GMT+0000 (UTC) -->	<html data-wf-site="5718896fb6f10eb45d8c7872" data-wf-page="5731981ac809f1bc5f09caa4">		<head>			<CFINCLUDE TEMPLATe="../_head.inc">						<SCRIPT LANGUAGE="javascript">				function blocking(nr)				{					if (document.layers)					{						current = (document.layers[nr].display == 'none') ? 'block' : 'none';						document.layers[nr].display = current;					}					else if (document.all)					{						current = (document.all[nr].style.display == 'none') ? 'block' : 'none';						document.all[nr].style.display = current;					}					else if (document.getElementById)					{						vista = (document.getElementById(nr).style.display == 'none') ? 'block' : 'none';						document.getElementById(nr).style.display = vista;					}				}				// -->			</SCRIPT>		</head>		<body>			<CFINCLUDE TEMPLATe="_menu.inc">						<CFINCLUDE TEMPLATe="_organisme.inc">						<!--- <div class="w-secti