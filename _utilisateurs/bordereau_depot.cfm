							<td style="text-align:right;">= ____________</td>
						</tr>
						
						<!--- <tr CLASS="monnaie" style="font-size:10px;">
							<td colspan="2" >&nbsp;</td>
							<td style="text-align:right;">_______ __________</td>
							<td >&nbsp;&nbsp;___________</td>
						</tr> --->
						<tr CLASS="monnaie" style="font-size:10px;">
