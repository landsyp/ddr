							<td >Date du dép&ocirc;t : </td>
							<td >_______________</td>
							<td >Type d'opération :</td>
							<td >_______________</td>
						</tr>
						<tr class="infoBordereau">
							<td>No. de dép&ocirc;t : </td>
							<td>_______________</td>
							<td>Folio :</td>
							<td><CFIF organisme.folio NEQ ""><cfoutput>#organisme.folio#</cfoutput><CFELSE>_______________</CFIF></td>
						</tr>
						<tr class="infoBordereau">
							<td>Compte bancaire : </td>
							<td>_______________</td>
							<td>Transit :</td>
							<td><CFIF organisme.transit NEQ ""><cfoutput>#organisme.transit#</cfoutput><CFELSE>_______________</CFIF></td>
