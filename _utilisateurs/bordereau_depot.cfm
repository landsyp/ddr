							<td  CLASS="EnteteColonne" style="width:20%;">Mode de paiement</td>
							<td  CLASS="EnteteColonne" style="text-align:right;width:20%;">Montant</td>
						</tr>
						<cfoutput query="bordereau" GROUP="mode">
							<cfset nombreMode=0>
							<cfset totalMode=0>
							<cfset YourDate = CreateDate(#Year#, #month#, 1)>
							
