						<tr CLASS="monnaie" >
							<td colspan="2" >&nbsp;</td>
							<td style="text-align:right;">________  X&nbsp;100,00 $</td>
							<td style="text-align:right;">= ____________</td>
						</tr>
						
						<!--- <tr CLASS="monnaie" style="font-size:10px;">
							<td colspan="2" >&nbsp;</td>
							<td style="text-align:right;">_______ __________</td>
							<td >&nbsp;&nbsp;___________</td>
						</tr> --->
						<tr CLASS="monnaie" style="font-size:10px;">
							<td colspan="2" >&nbsp;</td>
							<td style="text-align:right;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Monnaie &nbsp;</td>
							<td style="text-align:right;">= ______________</td>
						</tr>
						
						<!--- <tr >
							<td colspan="2" >&nbsp;</td>
							<td  STYLE="font-size:8pt;font-weight:bold;">Total comptant</td>
							<td STYLE="text-align:right;border-bottom: solid 2px  #BBB;font-weight:bold;"><cfoutput>#LSCurrencyFormat(totalMode)#</cfoutput></td>
						</tr> --->
						<tr>
							<td colspan="4">&nbsp;</td>
						</tr>
						<tr CLASS="BlocCorps" style="padding:4px 0px;">
							<td colspan="2" >_______________________________________</td>
							<td STYLE=" font-weight:bold; padding:4px 0px;">Total dép&ocirc;t</td>
							<td STYLE="text-align:right; font-weight:bold; font-size:11px;border-bottom: solid 2px  #BBB;padding:4px 0px;"><CFOUTPUT>#LSCurrencyFormat(TotalDepot)#</CFOUTPUT></td>
						</tr>
						<tr CLASS="BlocCorps" style="padding:4px 0px;">
							<td colspan="2" >Signature du déposant</td>
							<td colspan="2">&nbsp;</td>
							
						</tr>
					</table>
				<CFELSE>
					
					<table WIDTH="100%" border="0" cellpadding=2 cellspacing=0 CLASS="BlocCorps">
						
						<tr class="infoBordereau">
							<td >Date of deposit: </td>
							<td >_______________</td>
							<td >Type of operation:</td>
							<td >_______________</td>
						</tr>
						<tr class="infoBordereau">
							<td>Deposit No. : </td>
							<td>_______________</td>
							<td>Folio :</td>
							<td>_______________</td>
						</tr>
						<tr class="infoBordereau">
							<td>Bank Account : </td>
							<td>_______________</td>
							<td>Transit :</td>
							<td>_______________</td>
						</tr>
						<tr>
							<td colspan="4">&nbsp;</td>
						</tr>
						
						<tr>
							<td CLASS="EnteteColonne" style="width:20%;">Donor's No.</td>
							<td  CLASS="EnteteColonne" style="width:40%;">Name</td>
							<td  CLASS="EnteteColonne" style="width:20%;">Payment Method</td>
							<td  CLASS="EnteteColonne" style="text-align:right;width:20%;">Amount</td>
						</tr>
						<cfoutput query="bordereau" GROUP="mode">
							<cfset nombreMode=0>
							<cfset totalMode=0>
							<cfset YourDate = CreateDate(#Year#, #month#, 1)>
							
							<tr>
								<td colspan="4">&nbsp;</td>
							</tr>
							
							<CFOUTPUT>
								<cfset totalMode=totalMode+montant>
								
								<tr>
									<td>#numero#</td>
									<td >#nom#, #prenom#</td>
									<td >#mode#</td>
									<td STYLE="text-align:right;">#LSCurrencyFormat(montant)#</td>
								</tr>
								<cfset nombreMode++>
							</CFOUTPUT>
							<cfset TotalDepot=TotalDepot+totalMode>
							
							<tr STYLE="line-height:20px;">
								<td colspan="2" STYLE="font-size:9px;font-weight:bold;">Number of deposits #Lcase(mode)# : #nombreMode#</td>
								<td  STYLE="font-size:8pt;font-weight:bold;">Total (#mode#)</td>
								<td STYLE="text-align:right;border-bottom: solid 1px  black;font-weight:bold;">#LSCurrencyFormat(totalMode)#</td>
							</tr>
							
						</CFOUTPUT>
						
						<tr CLASS="BlocCorps" style="padding:4px 0px;">
							<td colspan="2" >&nbsp;</td>
							<td STYLE=" font-weight:bold; padding:4px 0px;">Total deposit</td>
							<td STYLE="text-align:right; font-weight:bold; font-size:11px;border-bottom: solid 2px  #BBB;padding:4px 0px;"><CFOUTPUT>#LSCurrencyFormat(TotalDepot)#</CFOUTPUT></td>
						</tr>
						
						<tr CLASS="BlocCorps" style="line-height:40px;">
							<td colspan="2" >&nbsp;</td>
							<td colspan="2" >Cash :</td>
						</tr>
						<tr CLASS="monnaie" >
							<td colspan="2" >&nbsp;</td>
							<td style="text-align:right;">________   X&nbsp;&nbsp;&nbsp;5,00 $</td>
							<td style="text-align:right;">= ____________</td>
						</tr>
						<tr CLASS="monnaie" >
							<td colspan="2" >&nbsp;</td>
