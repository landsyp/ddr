<cfcomponent displayname="utilisateurs" hint="Cette composante gere les fonctions pour l'utilisateur">		<!--- <cffunction name="connexion" access="remote" returntype="string" >			<cfargument name="courriel" required="true">			<cfargument name="mdp" required="true">			<CFSET LOCAL.message = "">						<CFQUERY NAME="VerifieUtilisateur" DATASOURCE="#APPLICATION.DSN#">			SELECT utilisateurID, admin, courriel, langue, mot_de_passe, nom, organismeID, prenom FROM utilisateurs			WHERE courriel = <CFQUERYPARAM VALUE="#Trim(arguments.courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50"> 			</CFQUERY>				<!--- COURRIEL INSCRIT DANS LA BD --->			<CFIF VerifieUtilisateur.RecordCount EQ 0>				<CFIF Session.langue EQ "fr">					<CFSET LOCAL.message = "Désolé nous ne pouvons vous authentifier avec ce courriel.">				<CFELSE>					<CFSET LOCAL.message = "Sorry we can't recognize your email.">				</CFIF>			<CFELSE>				<CFQUERY NAME="VerifieTrousse" DATASOURCE="#APPLICATION.DSN#">				SELECT trousse  FROM trousses				WHERE utilisateurID = <CFQUERYPARAM VALUE="#VerifieUtilisateur.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER"> 				</CFQUERY>				<CFIF VerifieUtilisateur.mot_de_passe EQ encrypt(arguments.mdp, VerifieTrousse.trousse, "AES", "Base64")>	        		<!--- CODES D'ACCES VALIDES --->	        		<!--- VERIFICATION DE LA LICENCE --->	        		<CFQUERY NAME="VerifieLicence" DATASOURCE="#APPLICATION.DSN#">					SELECT organismeID, organisme  FROM organismes					WHERE organismeID  = <CFQUERYPARAM VALUE="#VerifieUtilisateur.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">					AND	date_fin_licence	>=	<CFQUERYPARAM VALUE="#now()#" CFSQLTYPE="CF_SQL_DATE">					</CFQUERY>					<!--- LICENCE NON VALIDE --->					<CFIF VerifieLicence.RecordCount EQ 0>						<CFIF VerifieUtilisateur.langue EQ "fr">							<CFSET LOCAL.message = "Désolé votre licence pour l'utilisation de DDR a expirée. Veuillez communiquer avec nous.">						<CFELSE>							<CFSET LOCAL.message = "Your DDR license has expired. Please contact us.">						</CFIF>							    			<!--- CODES D'ACCES ET LICENCE VALIDES --->	    			<CFELSE>	    				<CFSET Session.langue = VerifieUtilisateur.langue>	        			<CFSET Session.utilisateur = StructNew()>	        			<CFIF VerifieUtilisateur.admin>							<CFSET Session.utilisateur.admin = "True">						<CFELSE>							<CFSET Session.utilisateur.admin = "False">						</CFIF>	        			<CFSET Session.utilisateur.courriel = VerifieUtilisateur.courriel>	        			<CFSET Session.utilisateur.langue = VerifieUtilisateur.langue>	        			<CFSET Session.utilisateur.nom = VerifieUtilisateur.nom>	        			<CFSET Session.utilisateur.organisme = VerifieLicence.organisme>	        			<CFSET Session.utilisateur.organismeID = VerifieUtilisateur.organismeID>						<CFSET Session.utilisateur.prenom = VerifieUtilisateur.prenom>						<CFSET Session.utilisateur.uID = VerifieUtilisateur.utilisateurID>												<CFIF VerifieUtilisateur.organismeID EQ 0>							<CFSET Session.utilisateur.supraAdmin = "True">						<CFELSE>							<CFSET Session.utilisateur.supraAdmin = "False">						</CFIF>																		<!--- ON VERROUILLE LES DONS AU CAS OU LA SESSION DE L'UTILISATEUR 								AURAIT EXPIRE AVANT UN LOGOUT  --->						<CFQUERY NAME="donsVerouiller" DATASOURCE="#APPLICATION.DSN#">						UPDATE dons							SET verouille = <CFQUERYPARAM VALUE="True" CFSQLTYPE="CF_SQL_BIT">						WHERE donID IN (SELECT donID FROM dons AS d 												INNER JOIN donateurs AS dr ON d.donateurID = dr.donateurID 												WHERE dr.organismeID = <CFQUERYPARAM VALUE="#Session.utilisateur.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">)						</CFQUERY>												<CFIF VerifieUtilisateur.langue EQ "fr">							<CFLOCATION URL="#APPLICATION.Racine#/fr/secure/accueil" ADDTOKEN="NO">						<CFELSE>							<CFLOCATION URL="#APPLICATION.Racine#/en/secure/home" ADDTOKEN="NO">						</CFIF>	    			</CFIF>		    		<CFELSE>	    			<CFIF VerifieUtilisateur.langue EQ "fr">						<CFSET LOCAL.message = "Votre mot de passe ne correspond pas &agrave; celui dans nos dossiers.">					<CFELSE>						<CFSET LOCAL.message = "Your password doesn't match the one contained in our files.">					</CFIF>				</CFIF>			</CFIF>						<CFRETURN LOCAL.message>			</cffunction> --->		<cffunction name="connexion" access="remote" returntype="string" >		<cfargument name="courriel" required="true">		<cfargument name="mdp" required="true">		<CFSET LOCAL.message = "">				<CFQUERY NAME="VerifieUtilisateur" DATASOURCE="#APPLICATION.DSN#">		SELECT utilisateurID, admin, courriel, langue, mot_de_passe, nom, organismeID, prenom, utilisateurStatutID FROM utilisateurs		WHERE courriel = <CFQUERYPARAM VALUE="#Trim(arguments.courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50"> 		AND		actif = <CFQUERYPARAM VALUE="True" CFSQLTYPE="CF_SQL_BIT">		</CFQUERY>		<!--- COURRIEL INSCRIT DANS LA BD --->		<CFIF VerifieUtilisateur.RecordCount EQ 0>			<CFIF Session.langue EQ "fr">				<CFSET LOCAL.message = "Désolé nous ne pouvons vous authentifier avec ce courriel ou votre compte est désactivé."> 			<CFELSE>				<CFSET LOCAL.message = "Sorry we can't recognize your email or your account is deactivated.">			</CFIF>		<CFELSE>			<!--- ON DOIT BOUCLER CAR IL Y A POSSIBLITE DE PLUSIEURS COMPTES AVEC MEME COURRIEL --->			<CFLOOP QUERY="VerifieUtilisateur">				<CFQUERY NAME="VerifieTrousse" DATASOURCE="#APPLICATION.DSN#">				SELECT trousse  FROM trousses				WHERE utilisateurID = <CFQUERYPARAM VALUE="#VerifieUtilisateur.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER"> 				</CFQUERY>				<cfset Session.mdpValide = VerifieUtilisateur.mot_de_passe&" "&VerifieTrousse.trousse>								<CFIF mot_de_passe EQ encrypt(arguments.mdp, VerifieTrousse.trousse, "AES", "Base64")>        		<!--- CODES D'ACCES VALIDES --->        								<!--- VERIFICATION DE LA LICENCE ET DE LA DEVISE --->					<CFQUERY NAME="VerifieLicence" DATASOURCE="#APPLICATION.DSN#">					SELECT organismeID, date_fin_licence, devise, organisme  FROM organismes					WHERE organismeID  = <CFQUERYPARAM VALUE="#organismeID#" CFSQLTYPE="CF_SQL_INTEGER">					AND	date_fin_licence	>=	<CFQUERYPARAM VALUE="#now()#" CFSQLTYPE="CF_SQL_DATE">					AND	actif = <CFQUERYPARAM VALUE="True" CFSQLTYPE="CF_SQL_BIT"> 					</CFQUERY>					<!--- LICENCE NON VALIDE --->					<CFIF VerifieLicence.RecordCount EQ 0> 						<cfset LOCAL.licenceExpiree=1> 						<CFIF langue EQ "fr">							<CFSET LOCAL.message = "Désolé votre licence pour l'utilisation de DDR a expirée. Veuillez communiquer avec nous.">						<CFELSE>							<CFSET LOCAL.message = "Your DDR license has expired. Please contact us.">						</CFIF>					<!--- CODES D'ACCES ET LICENCE VALIDES --->					<CFELSE>						<CFSET Session.langue = langue>						<CFSET Session.utilisateur = StructNew()>						<CFIF admin>							<CFSET Session.utilisateur.admin = "True">						<CFELSE>							<CFSET Session.utilisateur.admin = "False">						</CFIF>						<CFSET Session.utilisateur.courriel = courriel>						<CFSET Session.utilisateur.langue = langue>						<CFSET Session.utilisateur.nom = nom>						<CFSET Session.utilisateur.devise = VerifieLicence.devise>						<CFSET Session.utilisateur.organisme = VerifieLicence.organisme>						<CFSET Session.utilisateur.organismeID = organismeID>						<CFSET Session.utilisateur.prenom = prenom>						<CFSET Session.utilisateur.statut = utilisateurStatutID> 						<CFSET Session.utilisateur.uID = utilisateurID>												<CFIF organismeID EQ 0>							<CFSET Session.utilisateur.supraAdmin = "True">						<CFELSE>							<CFSET Session.utilisateur.supraAdmin = "False">						</CFIF>											<!--- ON VERROUILLE LES DONS AU CAS OU LA SESSION DE L'UTILISATEUR AURAIT EXPIREE AVANT UN LOGOUT  --->						<CFQUERY NAME="donsVerouiller" DATASOURCE="#APPLICATION.DSN#">						UPDATE dons							SET verouille = <CFQUERYPARAM VALUE="True" CFSQLTYPE="CF_SQL_BIT">						WHERE donID IN (SELECT donID FROM dons AS d 									INNER JOIN donateurs AS dr ON d.donateurID = dr.donateurID 									WHERE dr.organismeID = <CFQUERYPARAM VALUE="#Session.utilisateur.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">)						</CFQUERY>											<CFIF langue EQ "fr">							<CFLOCATION URL="#APPLICATION.Racine#/fr/secure/accueil" ADDTOKEN="NO">						<CFELSE>							<CFLOCATION URL="#APPLICATION.Racine#/en/secure/home" ADDTOKEN="NO">						</CFIF>    				</CFIF>	    			<CFELSE>    				<CFIF langue EQ "fr">						<CFSET LOCAL.message = "Votre mot de passe ne correspond pas à celui dans nos dossiers.">					<CFELSE>						<CFSET LOCAL.message = "Your password doesn't match the one contained in our files.">					</CFIF>				</CFIF>    		</CFLOOP>		</CFIF>				<CFRETURN LOCAL.message>	</cffunction>		<cffunction name="genPassword" output="true" access="remote">		<cfargument name="minLength" default="6">		<cfargument name="qtyNumbers" default="2">		<cfargument name="qtyLowerCaseAlpha" default="0">		<cfargument name="qtyUpperCaseAlpha" default="0">		<cfargument name="qtyOtherChars" default="0">		<cfscript>			var local=structNew();			// Set up strings to build the pw from			local.strLowerCaseAlpha = 'abcdefghjkmnpqrstuvwxyz';			local.strUpperCaseAlpha = UCase(local.strLowerCaseAlpha);			local.strNumbers = '23456789';			local.strOtherChars = '~!@$%^&*{}:;,.?/';			local.strAllValidChars = (				local.strLowerCaseAlpha &				local.strUpperCaseAlpha &				local.strNumbers &				local.strOtherChars				);				local.arrPassword = ArrayNew( 1 );				local.arrPassword=genPasswordPart(local.strNumbers, arguments.qtyNumbers, local.arrPassword);				local.arrPassword=genPasswordPart(local.strLowerCaseAlpha, arguments.qtyLowerCaseAlpha, local.arrPassword);				local.arrPassword=genPasswordPart(local.strUpperCaseAlpha, arguments.qtyUpperCaseAlpha, local.arrPassword);				local.arrPassword=genPasswordPart(local.strOtherChars, arguments.qtyOtherChars, local.arrPassword);				local.currentPWLength=arguments.minLength-ArrayLen( local.arrPassword );				//pad the rest of the password if needed				if(local.currentPWLength gt 0){					local.arrPassword=genPasswordPart(local.strLowerCaseAlpha, local.currentPWLength, local.arrPassword);				};				//shuffle				CreateObject( "java", "java.util.Collections" ).Shuffle(local.arrPassword);				// Array to list, makes it a string				local.strPassword = ArrayToList(local.arrPassword,"");				return local.strPassword;		</cfscript>	</cffunction>	<cffunction name="genPasswordPart" >		<cfargument name="stringType" required="true">		<cfargument name="quantity" required="true">		<cfargument name="passwordArray" required="true">		<cfscript>			var local=structNew();			if(arguments.quantity gt 0){				for(local.i=1;local.i lte arguments.quantity; local.i++) {					arguments.passwordArray[ arrayLen(arguments.passwordArray)+1 ] = Mid(					arguments.stringType,					RandRange( 1, Len(  arguments.stringType  ) )					,1					);				};			};			return arguments.passwordArray;		</cfscript>	</cffunction>		<cffunction name="utilisateurAjout" access="remote" returntype="string" >		<cfargument name="courriel" required="true" >		<cfargument name="langue" required="true" >		<cfargument name="nom" required="true" >		<cfargument name="organismeID"  required="true" >		<cfargument name="prenom" required="true" >		<cfargument name="statut" required="true">		<cfset LOCAL.mdpDecrypte = THIS.genPassword()>		<cfset LOCAL.LaCle=generateSecretKey("AES")>		<cfset LOCAL.mdpEncrypte = encrypt(LOCAL.mdpDecrypte, LOCAL.LaCle, "AES", "Base64")>				<CFIF arguments.statut EQ "1">			<CFSET LOCAL.admin = "True">		<CFELSE>			<CFSET LOCAL.admin = "False">		</CFIF>				<CFQUERY NAME="utilisateurAjout" DATASOURCE="#APPLICATION.DSN#" RESULT="NeoUtilisateur">		INSERT INTO utilisateurs (admin, courriel, langue, mot_de_passe, nom, organismeID, prenom, utilisateurStatutID)		VALUES (	<CFQUERYPARAM VALUE="#LOCAL..admin#" CFSQLTYPE="CF_SQL_BIT">,					<CFQUERYPARAM VALUE="#Trim(arguments.courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					<CFQUERYPARAM VALUE="#arguments.langue#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="2">,					<CFQUERYPARAM VALUE="#LOCAL.mdpEncrypte#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					<CFQUERYPARAM VALUE="#Trim(arguments.nom)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					<CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">,					<CFQUERYPARAM VALUE="#Trim(arguments.prenom)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					<CFQUERYPARAM VALUE="#arguments.statut#" CFSQLTYPE="CF_SQL_INTEGER">)		</CFQUERY>		<cfset LOCAL.utilisateurID = NeoUtilisateur.IDENTITYCOL>				<CFQUERY NAME="trousseAjout" DATASOURCE="#APPLICATION.DSN#" RESULT="NeoUtilisateur">		INSERT INTO trousses (utilisateurID, trousse)		VALUES (	<CFQUERYPARAM VALUE="#LOCAL.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">,					<CFQUERYPARAM VALUE="#LOCAL.LaCle#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">)		</CFQUERY>				<CFRETURN LOCAL.utilisateurID>			</cffunction>		<cffunction name="utilisateurEdition" access="remote" returntype="string" >		<cfargument name="courriel" required="true" >		<cfargument name="langue" required="true" >		<cfargument name="mot_de_passe"  required="true" >		<cfargument name="nom" required="true" >		<cfargument name="prenom" required="true" >		<cfargument name="statut" required="true">		<cfargument name="utilisateurID" required="true" >				<cfset LOCAL.LaCle=generateSecretKey("AES")>		<cfset LOCAL.mdpEncrypte = encrypt(arguments.mot_de_passe, LOCAL.LaCle, "AES", "Base64")>		<CFSET LOCAL.message = "">				<CFIF arguments.statut EQ "1">			<CFSET LOCAL.admin = "True">		<CFELSE>			<CFSET LOCAL.admin = "False">		</CFIF>				<CFQUERY NAME="utilisateurEdition" DATASOURCE="#APPLICATION.DSN#" RESULT="NeoUtilisateur">		UPDATE utilisateurs 			SET		admin 	= 	<CFQUERYPARAM VALUE="#LOCAL.admin#" CFSQLTYPE="CF_SQL_BIT">,					courriel	=	<CFQUERYPARAM VALUE="#Trim(arguments.courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					langue	=	<CFQUERYPARAM VALUE="#arguments.langue#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="2">,					mot_de_passe	=	<CFQUERYPARAM VALUE="#LOCAL.mdpEncrypte#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					nom		=	<CFQUERYPARAM VALUE="#Trim(arguments.nom)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					prenom	=	<CFQUERYPARAM VALUE="#Trim(arguments.prenom)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					utilisateurStatutID = <CFQUERYPARAM VALUE="#arguments.statut#" CFSQLTYPE="CF_SQL_INTEGER">			WHERE utilisateurID	=	<CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFIF Session.langue EQ "fr">			<CFSET LOCAL.message = "L'information a été mise &agrave; jour avec succ&egrave;s.">		<CFELSE>			<CFSET LOCAL.message = "Information was updated successfully.">		</CFIF>				<CFQUERY NAME="trousseAjout" DATASOURCE="#APPLICATION.DSN#" RESULT="NeoUtilisateur">			UPDATE trousses 			SET trousse = <CFQUERYPARAM VALUE="#LOCAL.LaCle#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">			WHERE utilisateurID	=	<CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFRETURN LOCAL.message>			</cffunction>		<cffunction name="utilisateurInfos" access="remote" returntype="query" >		<cfargument name="utilisateurID"  required="true" >				<CFQUERY NAME="utilisateurInfos" DATASOURCE="#APPLICATION.DSN#">		SELECT utilisateurID, actif, admin, courriel, langue, mot_de_passe, nom, nom_usager, organismeID, prenom, utilisateurStatutID FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFRETURN utilisateurInfos>	</cffunction>		<cffunction name="utilisateurInfos2" access="remote" returntype="query" >		<cfargument name="courriel"  required="true" >				<CFQUERY NAME="utilisateurInfos2" DATASOURCE="#APPLICATION.DSN#">		SELECT u.utilisateurID, u.courriel, u.langue, u.nom, u.prenom, o.organisme		FROM utilisateurs AS u		INNER JOIN organismes AS o ON u.organismeID = o.organismeID		WHERE courriel = <CFQUERYPARAM VALUE="#arguments.courriel#" CFSQLTYPE="CF_SQL_VARCHAR">		</CFQUERY>				<CFRETURN utilisateurInfos2>	</cffunction>		<cffunction name="utilisateurArchiver" access="remote" returntype="string" >		<cfargument name="utilisateurID"  required="true" >				<CFSET LOCAL.message = "">		<CFQUERY NAME="utilisateur" DATASOURCE="#APPLICATION.DSN#">		SELECT *		FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<CFQUERY NAME="utilisateurArchiver" DATASOURCE="#APPLICATION.DSN#">		UPDATE utilisateurs		SET actif = <CFQUERYPARAM VALUE="False" CFSQLTYPE="CF_SQL_BIT">		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>			<CFIF session.langue EQ "fr">			<CFSET LOCAL.message = "Utilisateur #utilisateur.prenom# #utilisateur.nom# a été archivé avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "User #utilisateur.prenom# #utilisateur.nom# was archived successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>		<cffunction name="utilisateurActiver" access="remote" returntype="string" >		<cfargument name="utilisateurID"  required="true" >				<CFSET LOCAL.message = "">				<CFQUERY NAME="utilisateur" DATASOURCE="#APPLICATION.DSN#">		SELECT *		FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFQUERY NAME="utilisateurActiver" DATASOURCE="#APPLICATION.DSN#">		UPDATE utilisateurs		SET actif = <CFQUERYPARAM VALUE="True" CFSQLTYPE="CF_SQL_BIT">		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>			<CFIF session.langue EQ "fr">			<CFSET LOCAL.message = "Utilisateur #utilisateur.prenom# #utilisateur.nom# a été activé avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "User #utilisateur.prenom# #utilisateur.nom# was activated successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>		<cffunction name="utilisateursListe" access="remote" returntype="query" >		<cfargument name="langue"  required="true" >		<cfargument name="organismeID"  required="true" >				<CFQUERY NAME="utilisateursListe" DATASOURCE="#APPLICATION.DSN#">		SELECT u.*, t.trousse, us.utilisateurStatut_#arguments.langue# as statut, us.note_#arguments.langue# as note  FROM utilisateurs as u			INNER JOIN trousses AS t ON u.utilisateurID = t.utilisateurID			INNER JOIN utilisateurStatuts AS us ON u.utilisateurStatutID = us.utilisateurStatutID		WHERE u.organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFRETURN utilisateursListe>	</cffunction>		<cffunction name="UtilisateurMDPDecrypt" access="remote" returntype="string" >		<cfargument name="utilisateurID"  required="true" >				<CFQUERY NAME="trousse" DATASOURCE="#APPLICATION.DSN#">		SELECT trousse FROM trousses		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFQUERY NAME="mdp" DATASOURCE="#APPLICATION.DSN#">		SELECT mot_de_passe FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<cfset LOCAL.mdp = decrypt(mdp.mot_de_passe, trousse.trousse, "AES", "Base64")>				<CFRETURN LOCAL.mdp>	</cffunction>		<cffunction name="UtilisateurStatuts" access="remote" returntype="query" >		<cfargument name="langue"  required="true" >				<CFQUERY NAME="UtilisateurStatuts" DATASOURCE="#APPLICATION.DSN#">		SELECT utilisateurStatutID, utilisateurStatut_#arguments.langue# as statut, note_#arguments.langue# as note  FROM utilisateurStatuts		ORDER BY utilisateurStatutID		</CFQUERY>		<CFRETURN UtilisateurStatuts>	</cffunction>		<cffunction name="utilisateurSuppression" access="remote" returntype="string" >		<cfargument name="utilisateurID"  required="true" >				<CFSET LOCAL.message = "">				<CFQUERY NAME="utilisateurSuppression" DATASOURCE="#APPLICATION.DSN#">		DELETE FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<CFQUERY NAME="trousseSuppression" DATASOURCE="#APPLICATION.DSN#">		DELETE FROM trousses		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFIF session.utilisateur.langue EQ "fr">			<CFSET LOCAL.message = "Utilisateur supprimé avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "User deleted successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>		<cffunction name="organismeInfos" access="remote" returntype="query" >		<cfargument name="organismeID"  required="true" >				<CFQUERY NAME="organismeInfos" DATASOURCE="#APPLICATION.DSN#">		SELECT adresse, code_postal, date_fin_licence, devise, enregistrement, etatID, folio, logo, logoExt, membre, organisme, provinceID, reponse_courriel, responsable, responsable_courriel, signatureExt, telephone, transit, ville 			FROM organismes		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFRETURN organismeInfos>	</cffunction>		<cffunction name="organismeEdition" access="remote" returntype="string" >		<cfargument name="adresse"  required="true" >		<cfargument name="code_postal" required="true" >		<cfargument name="enregistrement" required="true" >		<cfargument name="folio" required="false" default="" >		<cfargument name="logoExt" required="true" >		<cfargument name="organisme" required="true" >		<cfargument name="provinceID" required="true" >		<cfargument name="responsable" required="true" >		<cfargument name="reponse_courriel" required="true" >		<cfargument name="responsable_courriel" required="true" >		<cfargument name="signatureExt" required="true" >		<cfargument name="telephone" required="true" >		<cfargument name="transit" required="false" default="" >		<cfargument name="ville" required="true" >		<cfargument name="organismeID" required="true" >				<CFQUERY NAME="organismeEdition" DATASOURCE="#APPLICATION.DSN#" >		UPDATE organismes 			SET	adresse	=	<CFQUERYPARAM VALUE="#Trim(arguments.adresse)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="150" NULL="#arguments.adresse EQ ""#">,					code_postal	=	<CFQUERYPARAM VALUE="#Trim(arguments.code_postal)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="20" NULL="#arguments.code_postal EQ ""#">,					reponse_courriel		=	<CFQUERYPARAM VALUE="#Trim(arguments.reponse_courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="100" NULL="#arguments.reponse_courriel EQ ""#">,					enregistrement	=	<CFQUERYPARAM VALUE="#Trim(arguments.enregistrement)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30">,					folio	=	<CFQUERYPARAM VALUE="#Trim(arguments.folio)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30" NULL="#arguments.folio EQ ""#">,					<CFIF arguments.logoExt NEQ "">logoExt = <CFQUERYPARAM VALUE="#Trim(arguments.logoExt)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="5">,</CFIF>					organisme 	= 	<CFQUERYPARAM VALUE="#Trim(arguments.organisme)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="100">,					provinceId	=	<CFQUERYPARAM VALUE="#arguments.provinceID#" CFSQLTYPE="CF_SQL_INTEGER">,					responsable	=	<CFQUERYPARAM VALUE="#Trim(arguments.responsable)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					responsable_courriel	=	<CFQUERYPARAM VALUE="#Trim(arguments.responsable_courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="100" NULL="#arguments.responsable_courriel EQ ""#">,					<CFIF arguments.signatureExt NEQ "">signatureExt = <CFQUERYPARAM VALUE="#Trim(arguments.signatureExt)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="5">,</CFIF>					telephone	=	<CFQUERYPARAM VALUE="#Trim(arguments.telephone)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30" NULL="#arguments.telephone EQ ""#">,					transit	=	<CFQUERYPARAM VALUE="#Trim(arguments.transit)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="20" NULL="#arguments.transit EQ ""#">,					ville		=	<CFQUERYPARAM VALUE="#Trim(arguments.ville)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50" NULL="#arguments.ville EQ ""#">			WHERE organismeID	=	<CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">				</CFQUERY>				<CFIF Session.langue EQ "fr">			<CFSET LOCAL.message = "L'information a été mise &agrave; jour avec succ&egrave;s.">		<CFELSE>			<CFSET LOCAL.message = "Information was updated successfully.">		</CFIF>				<CFRETURN LOCAL.message>			</cffunction>	</cfcomponent>