<cfcomponent displayname="admin" hint="Cette composante gere les fonctions pour l'admin">				<cffunction name="utilisateurAjout" access="remote" returntype="string" >		<cfargument name="admin" required="false" default="False" >		<cfargument name="courriel" required="true" >		<cfargument name="langue" required="true" >		<cfargument name="nom" required="true" >		<cfargument name="organismeID"  required="true" >		<cfargument name="prenom" required="true" >				<cfset LOCAL.mdpDecrypte = THIS.genPassword()>		<cfset LOCAL.LaCle=generateSecretKey("AES")>		<cfset LOCAL.mdpEncrypte = encrypt(LOCAL.mdpDecrypte, LOCAL.LaCle, "AES", "Base64")>				<CFQUERY NAME="utilisateurAjout" DATASOURCE="#APPLICATION.DSN#" RESULT="NeoUtilisateur">		INSERT INTO utilisateurs (admin, courriel, langue, mot_de_passe, nom, organismeID, prenom)		VALUES (	<CFQUERYPARAM VALUE="#arguments.admin#" CFSQLTYPE="CF_SQL_BIT">,					<CFQUERYPARAM VALUE="#Trim(arguments.courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					<CFQUERYPARAM VALUE="#arguments.langue#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="2">,					<CFQUERYPARAM VALUE="#LOCAL.mdpEncrypte#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					<CFQUERYPARAM VALUE="#Trim(arguments.nom)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					<CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">,					<CFQUERYPARAM VALUE="#Trim(arguments.prenom)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">)		</CFQUERY>		<cfset LOCAL.utilisateurID = NeoUtilisateur.IDENTITYCOL>				<CFQUERY NAME="trousseAjout" DATASOURCE="#APPLICATION.DSN#" RESULT="NeoUtilisateur">		INSERT INTO trousses (utilisateurID, trousse)		VALUES (	<CFQUERYPARAM VALUE="#LOCAL.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">,					<CFQUERYPARAM VALUE="#LOCAL.LaCle#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">)		</CFQUERY>				<CFRETURN LOCAL.utilisateurID>			</cffunction>		<cffunction name="utilisateurEdition" access="remote" returntype="string" >		<cfargument name="admin" required="false" default="false" >		<cfargument name="courriel" required="true" >		<cfargument name="langue" required="true" >		<cfargument name="mot_de_passe"  required="true" >		<cfargument name="nom" required="true" >		<cfargument name="prenom" required="true" >		<cfargument name="utilisateurID" required="true" >		<cfset LOCAL.LaCle=generateSecretKey("AES")>		<cfset LOCAL.mdpEncrypte = encrypt(arguments.mot_de_passe, LOCAL.LaCle, "AES", "Base64")>		<CFSET LOCAL.message = "">				<CFQUERY NAME="utilisateurEdition" DATASOURCE="#APPLICATION.DSN#" RESULT="NeoUtilisateur">		UPDATE utilisateurs 			SET	admin 	= 	<CFQUERYPARAM VALUE="#arguments.admin#" CFSQLTYPE="CF_SQL_BIT">,					courriel	=	<CFQUERYPARAM VALUE="#Trim(arguments.courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					langue	=	<CFQUERYPARAM VALUE="#arguments.langue#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="2">,					mot_de_passe	=	<CFQUERYPARAM VALUE="#LOCAL.mdpEncrypte#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					nom		=	<CFQUERYPARAM VALUE="#Trim(arguments.nom)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,					prenom	=	<CFQUERYPARAM VALUE="#Trim(arguments.prenom)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">			WHERE utilisateurID	=	<CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">				</CFQUERY>				<CFIF Session.langue EQ "fr">			<CFSET LOCAL.message = "L'information a &eacute;t&eacute; mise &agrave; jour avec succ&egrave;s.">		<CFELSE>			<CFSET LOCAL.message = "Information was updated successfully.">		</CFIF>				<CFQUERY NAME="trousseAjout" DATASOURCE="#APPLICATION.DSN#" RESULT="NeoUtilisateur">		UPDATE trousses 			SET trousse = <CFQUERYPARAM VALUE="#LOCAL.LaCle#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">			WHERE utilisateurID	=	<CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFRETURN LOCAL.message>			</cffunction>		<cffunction name="trouveUtilisateursAdmin" access="remote" returntype="query" >		<cfargument name="organismeID"  required="true" >				<CFQUERY NAME="trouveUtilisateurs" DATASOURCE="#APPLICATION.DSN#">		SELECT u.utilisateurID, u.actif, u.admin, u.courriel, u.langue, u.mot_de_passe,u.nom, u.nom_usager, u.organismeID, u.prenom, o.organisme		FROM utilisateurs AS u			INNER JOIN organismes AS o ON u.organismeID = o.organismeID		WHERE u.organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		AND 	u.admin	=	<CFQUERYPARAM VALUE="True" CFSQLTYPE="CF_SQL_BIT">		AND		u.actif = 	<CFQUERYPARAM VALUE="True" CFSQLTYPE="CF_SQL_BIT">		ORDER BY u.organismeID		</CFQUERY>				<CFRETURN trouveUtilisateurs>	</cffunction>		<cffunction name="utilisateurInfos" access="remote" returntype="query" >		<cfargument name="utilisateurID"  required="true" >				<CFQUERY NAME="utilisateurInfos" DATASOURCE="#APPLICATION.DSN#">		SELECT * FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFRETURN utilisateurInfos>	</cffunction>		<cffunction name="utilisateurInfos2" access="remote" returntype="query" >		<cfargument name="courriel"  required="true" >				<CFQUERY NAME="utilisateurInfos2" DATASOURCE="#APPLICATION.DSN#">		SELECT u.utilisateurID, u.courriel, u.langue, u.nom, u.prenom, o.organisme		FROM utilisateurs AS u		INNER JOIN organismes AS o ON u.organismeID = o.organismeID		WHERE courriel = <CFQUERYPARAM VALUE="#arguments.courriel#" CFSQLTYPE="CF_SQL_VARCHAR">		</CFQUERY>				<CFRETURN utilisateurInfos2>	</cffunction>		<cffunction name="utilisateurArchiver" access="remote" returntype="string" >		<cfargument name="utilisateurID"  required="true" >				<CFSET LOCAL.message = "">		<CFQUERY NAME="utilisateur" DATASOURCE="#APPLICATION.DSN#">		SELECT *		FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<CFQUERY NAME="utilisateurArchiver" DATASOURCE="#APPLICATION.DSN#">		UPDATE utilisateurs		SET actif = <CFQUERYPARAM VALUE="False" CFSQLTYPE="CF_SQL_BIT">		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>			<CFIF session.langue EQ "fr">			<CFSET LOCAL.message = "Utilisateur #utilisateur.prenom# #utilisateur.nom# a &eacute;t&eacute; archiv&eacute; avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "User #utilisateur.prenom# #utilisateur.nom# was archived successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>		<cffunction name="utilisateurActiver" access="remote" returntype="string" >		<cfargument name="utilisateurID"  required="true" >				<CFSET LOCAL.message = "">				<CFQUERY NAME="utilisateur" DATASOURCE="#APPLICATION.DSN#">		SELECT *		FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFQUERY NAME="utilisateurActiver" DATASOURCE="#APPLICATION.DSN#">		UPDATE utilisateurs		SET actif = <CFQUERYPARAM VALUE="True" CFSQLTYPE="CF_SQL_BIT">		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>			<CFIF session.langue EQ "fr">			<CFSET LOCAL.message = "Utilisateur #utilisateur.prenom# #utilisateur.nom# a &eacute;t&eacute; activ&eacute; avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "User #utilisateur.prenom# #utilisateur.nom# was activated successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>		<cffunction name="utilisateursListe" access="remote" returntype="query" >		<cfargument name="organismeID"  required="true" >				<CFQUERY NAME="utilisateursListe" DATASOURCE="#APPLICATION.DSN#">		SELECT u.*, t.trousse FROM utilisateurs as u			INNER JOIN trousses AS t ON u.utilisateurID = t.utilisateurID		WHERE u.organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFRETURN utilisateursListe>	</cffunction>		<cffunction name="UtilisateurMDPDecrypt" access="remote" returntype="string" >		<cfargument name="utilisateurID"  required="true" >				<CFQUERY NAME="trousse" DATASOURCE="#APPLICATION.DSN#">		SELECT trousse FROM trousses		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFQUERY NAME="mdp" DATASOURCE="#APPLICATION.DSN#">		SELECT mot_de_passe FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<cfset LOCAL.mdp = decrypt(mdp.mot_de_passe, trousse.trousse, "AES", "Base64")>				<CFRETURN LOCAL.mdp>	</cffunction>			<cffunction name="utilisateurSuppression" access="remote" returntype="string" >		<cfargument name="utilisateurID"  required="true" >				<CFSET LOCAL.message = "">				<CFQUERY NAME="utilisateurSuppression" DATASOURCE="#APPLICATION.DSN#">		DELETE FROM utilisateurs		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<CFQUERY NAME="trousseSuppression" DATASOURCE="#APPLICATION.DSN#">		DELETE FROM trousses		WHERE utilisateurID = <CFQUERYPARAM VALUE="#arguments.utilisateurID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFIF session.utilisateur.langue EQ "fr">			<CFSET LOCAL.message = "Utilisateur supprim&eacute; avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "User deleted successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>		<cffunction name="organismeAjout" access="remote" returntype="string" >		<cfargument name="actif"  required="true" >		<cfargument name="adresse"  required="true" >		<cfargument name="code_postal" required="true" >		<cfargument name="date_fin_licence" required="true" >		<cfargument name="devise" required="true" >		<cfargument name="enregistrement" required="true" >		<cfargument name="enregistrement_us" required="true" >		<cfargument name="interne" required="true" >		<cfargument name="membre" required="true" >		<cfargument name="organisme" required="true" >		<cfargument name="provinceID" required="true" >		<cfargument name="responsable" required="true" >		<cfargument name="responsable_courriel" required="true" >		<cfargument name="telephone" required="true" >		<cfargument name="ville" required="true" >				<CFQUERY NAME="checkName" DATASOURCE="#APPLICATION.DSN#">			SELECT organismeID FROM organismes			WHERE	organisme = <CFQUERYPARAM VALUE="#arguments.organisme#" CFSQLTYPE="CF_SQL_VARCHAR">		</CFQUERY>				<CFIF checkName.recordcount EQ 0>					<CFQUERY NAME="organismeAjout" DATASOURCE="#APPLICATION.DSN#" RESULT="Neoorganisme">			INSERT INTO organismes (actif, adresse, code_postal, date_fin_licence, devise, enregistrement, enregistrement_us, interne, membre, organisme, provinceID, responsable, responsable_courriel, telephone, ville)			VALUES (	<CFQUERYPARAM VALUE="#Trim(arguments.actif)#" CFSQLTYPE="CF_SQL_BIT">,						<CFQUERYPARAM VALUE="#Trim(arguments.adresse)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="150" NULL="#arguments.adresse EQ ""#">,						<CFQUERYPARAM VALUE="#Trim(arguments.code_postal)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="20" NULL="#arguments.code_postal EQ ""#">,						<CFQUERYPARAM VALUE="#arguments.date_fin_licence#" CFSQLTYPE="CF_SQL_DATE"  NULL="#arguments.date_fin_licence EQ ""#">,						<CFQUERYPARAM VALUE="#arguments.devise#" CFSQLTYPE="CF_SQL_VARCHAR">,						<CFQUERYPARAM VALUE="#Trim(arguments.enregistrement)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30" NULL="#arguments.enregistrement EQ ""#">,						<CFQUERYPARAM VALUE="#Trim(arguments.enregistrement_us)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30" NULL="#arguments.enregistrement_us EQ ""#">,						<CFQUERYPARAM VALUE="#Trim(arguments.interne)#" CFSQLTYPE="CF_SQL_BIT">,						<CFQUERYPARAM VALUE="#Trim(arguments.membre)#" CFSQLTYPE="CF_SQL_BIT">,						<CFQUERYPARAM VALUE="#Trim(arguments.organisme)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,						<CFQUERYPARAM VALUE="#arguments.provinceID#" CFSQLTYPE="CF_SQL_INTEGER" NULL="#arguments.provinceID EQ 0#">,						<CFQUERYPARAM VALUE="#Trim(arguments.responsable)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,						<CFQUERYPARAM VALUE="#Trim(arguments.responsable_courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="100" NULL="#arguments.responsable_courriel EQ ""#">,						<CFQUERYPARAM VALUE="#Trim(arguments.telephone)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30" NULL="#arguments.telephone EQ ""#">,											<CFQUERYPARAM VALUE="#Trim(arguments.ville)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50" NULL="#arguments.ville EQ ""#">)			</CFQUERY>			<cfset LOCAL.organismeID = Neoorganisme.IDENTITYCOL>		<CFELSE>			<cfset LOCAL.organismeID = 0>		</CFIF>				<CFRETURN LOCAL.organismeID>			</cffunction>		<cffunction name="organismeEdition" access="remote" returntype="string" >		<cfargument name="actif"  required="true" >		<cfargument name="adresse"  required="true" >		<cfargument name="code_postal" required="true" >		<cfargument name="date_fin_licence" required="true" >		<cfargument name="devise" required="true" >		<cfargument name="enregistrement" required="true" >		<cfargument name="enregistrement_us" required="true" >		<cfargument name="interne" required="true" >		<cfargument name="membre" required="true" >		<cfargument name="organisme" required="true" >		<cfargument name="provinceID" required="true" >		<cfargument name="responsable" required="true" >		<cfargument name="responsable_courriel" required="true" >		<!--- <cfargument name="signatureExt" required="true" > --->		<cfargument name="telephone" required="true" >		<cfargument name="ville" required="true" >		<cfargument name="organismeID" required="true" >				<CFQUERY NAME="organismeEdition" DATASOURCE="#APPLICATION.DSN#" >		UPDATE organismes 			SET	actif 		=	<CFQUERYPARAM VALUE="#arguments.actif#" CFSQLTYPE="CF_SQL_BIT">,				adresse		=	<CFQUERYPARAM VALUE="#Trim(arguments.adresse)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="150" NULL="#arguments.adresse EQ ""#">,				code_postal	=	<CFQUERYPARAM VALUE="#Trim(arguments.code_postal)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="20" NULL="#arguments.code_postal EQ ""#">,				date_fin_licence = <CFQUERYPARAM VALUE="#arguments.date_fin_licence#" CFSQLTYPE="CF_SQL_DATE">,				devise		=	<CFQUERYPARAM VALUE="#arguments.devise#" CFSQLTYPE="CF_SQL_VARCHAR">,				enregistrement	=	<CFQUERYPARAM VALUE="#Trim(arguments.enregistrement)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30">,				enregistrement_us	=	<CFQUERYPARAM VALUE="#Trim(arguments.enregistrement_us)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30">,				interne		=	<CFQUERYPARAM VALUE="#arguments.interne#" CFSQLTYPE="CF_SQL_BIT">,				membre		=	<CFQUERYPARAM VALUE="#arguments.membre#" CFSQLTYPE="CF_SQL_BIT">,				organisme 	= 	<CFQUERYPARAM VALUE="#Trim(arguments.organisme)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="250">,				provinceId	=	<CFQUERYPARAM VALUE="#arguments.provinceID#" CFSQLTYPE="CF_SQL_INTEGER">,				responsable	=	<CFQUERYPARAM VALUE="#Trim(arguments.responsable)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50">,				responsable_courriel	=	<CFQUERYPARAM VALUE="#Trim(arguments.responsable_courriel)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="100">,				<!--- <CFIF arguments.signatureExt NEQ "">signatureExt = <CFQUERYPARAM VALUE="#Trim(arguments.signatureExt)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="5">,</CFIF> --->				telephone	=	<CFQUERYPARAM VALUE="#Trim(arguments.telephone)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="30" NULL="#arguments.telephone EQ ""#">,				ville		=	<CFQUERYPARAM VALUE="#Trim(arguments.ville)#" CFSQLTYPE="CF_SQL_VARCHAR" maxlength="50" NULL="#arguments.ville EQ ""#">			WHERE organismeID	=	<CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">				</CFQUERY>				<CFIF Session.langue EQ "fr">			<CFSET LOCAL.message = "L'information a &eacute;t&eacute; mise &agrave; jour avec succ&egrave;s.">		<CFELSE>			<CFSET LOCAL.message = "Information was updated successfully.">		</CFIF>				<CFRETURN LOCAL.message>			</cffunction>		<cffunction name="organismeInfos" access="remote" returntype="query" >		<cfargument name="organismeID"  required="true" >				<CFQUERY NAME="organismeInfos" DATASOURCE="#APPLICATION.DSN#"> 		SELECT actif, adresse, code_postal, date_fin_licence, devise, enregistrement, enregistrement_us, etatID, folio, logoExt, interne, membre, organisme, provinceID, responsable, responsable_courriel, signatureExt, telephone, transit, ville 			FROM organismes		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>				<CFRETURN organismeInfos> 	</cffunction>		<cffunction name="organismesListe" access="remote" returntype="query" >		<CFQUERY NAME="organismesListe" DATASOURCE="#APPLICATION.DSN#">		SELECT organismeID, actif, adresse, code_postal, date_fin_licence, enregistrement, etatID, interne, membre, organisme, provinceID, responsable, responsable_courriel, signatureExt, telephone, ville 		FROM organismes 		<!--- WHERE actif = <CFQUERYPARAM VALUE="TRUE" CFSQLTYPE="CF_SQL_BIT"> ---> 		ORDER BY organisme		</CFQUERY>				<CFRETURN organismesListe>	</cffunction>		<cffunction name="organismesListeRecherche" access="remote" returntype="query" >		<cfargument name="recherche"  required="true" >		<CFQUERY NAME="organismesListeRecherche" DATASOURCE="#APPLICATION.DSN#">		SELECT organismeID, actif, adresse, code_postal, date_fin_licence, enregistrement, etatID, interne, membre, organisme, provinceID, responsable, responsable_courriel, signatureExt, telephone, ville 		FROM organismes 		WHERE organisme LIKE <CFQUERYPARAM VALUE="%#arguments.recherche#%" CFSQLTYPE="CF_SQL_VARCHAR"> 		ORDER BY organisme		</CFQUERY>				<CFRETURN organismesListeRecherche>	</cffunction>		<cffunction name="organismesExternesListe" access="remote" returntype="query" >		<CFQUERY NAME="organismesExternesListe" DATASOURCE="#APPLICATION.DSN#">		SELECT organismeID, actif, adresse, code_postal, date_fin_licence, enregistrement, etatID, membre, organisme, provinceID, responsable, responsable_courriel, signatureExt, telephone, ville 		FROM organismes 		WHERE interne = <CFQUERYPARAM VALUE="false" CFSQLTYPE="CF_SQL_BIT">		AND		organismeID NOT IN (0,5,133)		ORDER BY date_fin_licence		</CFQUERY>				<CFRETURN organismesExternesListe>	</cffunction>		<cffunction name="organismesInternesListe" access="remote" returntype="query" >		<CFQUERY NAME="organismesInternesListe" DATASOURCE="#APPLICATION.DSN#">		SELECT organismeID, actif, adresse, code_postal, date_fin_licence, enregistrement, etatID, membre, organisme, provinceID, responsable, responsable_courriel, signatureExt, telephone, ville 		FROM organismes 		WHERE interne = <CFQUERYPARAM VALUE="true" CFSQLTYPE="CF_SQL_BIT">		</CFQUERY>				<CFRETURN organismesInternesListe>	</cffunction>		<cffunction name="organismeArchiver" access="remote" returntype="string" >		<cfargument name="organismeID"  required="true" >				<CFSET LOCAL.message = "">		<CFQUERY NAME="organisme" DATASOURCE="#APPLICATION.DSN#">		SELECT *		FROM organismes		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<CFQUERY NAME="organismeArchiver" DATASOURCE="#APPLICATION.DSN#">		UPDATE organismes		SET actif = <CFQUERYPARAM VALUE="False" CFSQLTYPE="CF_SQL_BIT">		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>			<CFIF session.langue EQ "fr">			<CFSET LOCAL.message = "Organisme #organisme.organisme# a &eacute;t&eacute; archiv&eacute; avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "Charity #organisme.organisme# was archived successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>		<cffunction name="organismeActiver" access="remote" returntype="string" >		<cfargument name="organismeID"  required="true" >				<CFSET LOCAL.message = "">		<CFQUERY NAME="organisme" DATASOURCE="#APPLICATION.DSN#">		SELECT *		FROM organismes		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<CFQUERY NAME="organismeActiver" DATASOURCE="#APPLICATION.DSN#">		UPDATE organismes		SET actif = <CFQUERYPARAM VALUE="true" CFSQLTYPE="CF_SQL_BIT">		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>			<CFIF session.langue EQ "fr">			<CFSET LOCAL.message = "l'organisme #organisme.organisme# a &eacute;t&eacute; activ&eacute; avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "Charity #organisme.organisme# was activated successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>		<!--- 	FONCTION NON UTILISEE SUR LE SITE POUR SUPPRIMER UN ORGANISME 			MEME FONCTION A routines/supprimer_organisme.cfm --->	<cffunction name="organismeSuppression" access="remote" returntype="string" >		<cfargument name="organismeID"  required="true" >				<CFSET LOCAL.message = "">				<CFQUERY NAME="utilisateurs" DATASOURCE="#APPLICATION.DSN#">		SELECT utilisateurID FROM utilisateurs		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<CFSET les_utilisateurs = ValueList(utilisateurs.utilisateurID)>		<!--- SUPPRIMER VISITES --->		<CFQUERY NAME="visitesSupprimer" DATASOURCE="#APPLICATION.DSN#">		DELETE  FROM visites		WHERE utilisateurID IN (<CFQUERYPARAM VALUE="#les_utilisateurs#" CFSQLTYPE="CF_SQL_INTEGER" LIST="yes">)		</CFQUERY>		<!--- SUPPRIMER TROUSSE --->		<CFQUERY NAME="troussesSupprimer" DATASOURCE="#APPLICATION.DSN#">		DELETE  FROM trousses		WHERE utilisateurID IN (<CFQUERYPARAM VALUE="#les_utilisateurs#" CFSQLTYPE="CF_SQL_INTEGER" LIST="yes">)		</CFQUERY>		<!--- SUPPRIMER UTILISATEURS --->		<CFQUERY NAME="utilisateursSupprimer" DATASOURCE="#APPLICATION.DSN#">		DELETE  FROM utilisateurs		WHERE utilisateurID IN (<CFQUERYPARAM VALUE="#les_utilisateurs#" CFSQLTYPE="CF_SQL_INTEGER" LIST="yes">)		</CFQUERY>		<!--- SUPPRIMER DONS --->		<CFQUERY NAME="donsSupprimer" DATASOURCE="#APPLICATION.DSN#">		DELETE  FROM dons		WHERE 	donateurID IN (SELECT donateurID FROM donateurs WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">)		</CFQUERY>		<!--- SUPPRIMER DONATEURS --->		<CFQUERY NAME="donateursSupprimer" DATASOURCE="#APPLICATION.DSN#">		DELETE  FROM donateurs		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<!--- SUPPRIMER COMPTES --->		<CFQUERY NAME="comptesSupprimer" DATASOURCE="#APPLICATION.DSN#">		DELETE  FROM comptes		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>		<!--- SUPPRIMER ORGANISME --->		<CFQUERY NAME="organismeSupprimer" DATASOURCE="#APPLICATION.DSN#">		DELETE  FROM organismes		WHERE organismeID = <CFQUERYPARAM VALUE="#arguments.organismeID#" CFSQLTYPE="CF_SQL_INTEGER">		</CFQUERY>						<CFIF session.langue EQ "fr">			<CFSET LOCAL.message = "L'organisme #organisme.organisme# a &eacute;t&eacute; supprim&eacute; avec succ&egrave;s">		<CFELSE>			<CFSET LOCAL.message = "Charity #organisme.organisme# was deleted successfully">		</CFIF>		<CFRETURN LOCAL.message>	</cffunction>	</cfcomponent>