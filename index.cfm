rez sous peu vos codes d'acc&egrave;s.">			<CFELSE>				<cfset message="Check your inbox, you will receive information to log in to your account.">			</CFIF>		</CFIF>								</CFIF><!DOCTYPE html><!-- This site was created in Webflow. http://www.webflow.com--><!-- Last Published: Thu Jun 16 2016 16:27:16 GMT+0000 (UTC) --><html data-wf-site="5718896fb6f10eb45d8c7872" data-wf-page="5762c676d86198e52416ed61">	<head>		<CFINCLUDE TEMPLATe="_head.inc">	</head>	<!--- <CFIF Session.langue EQ "fr">			<CFform method="POST" action="#file_name_fr#" class="course-finder-form clearfix">										<CFinput type="text" value="" name="courriel" placeholder="Courriel" required message="Veuillez inscrire votre courriel"/>				<CFinput type="password" value="" name="mdp" placeholder="Mot de passe" Message="Veuillez inscrire votre mot de passe" required />											<input name="connexion" type="submit" value="Soumettre" />								</CFform>		<CFELSE>			<CFform method="POST" action="#file_name_en#" class="course-finder-form clearfix">										<CFinput type="text" value="" name="courriel" placeholder="Courriel" required message="Please enter your email address"/>				<CFinput type="password" value="" name="mdp" placeholder="Mot de passe" Message="Please enter your password" required />											<input name="connexion" type="submit" value="Send" />								</CFform>		</CFIF> --->		<body class="stylebody">				<CFINCLUDE TEMPLATe="_menu.inc">			<CFIF Session.langue EQ "fr">			<div class="modalwrapper" data-ix="modal-interaction-email">				<div class="motdepassemodal"><a class="ajoutpadding lienbleu" data-ix="fermermodalemail" href="#">Fermer X</a>					<p class="ajouterpaddinglogin">Veuillez inscrire votre adresse courriel afin que nous puissions vous transmettre votre mot de passe.</p>					<div class="w-form">						<cfform action="#file_name_fr#" data-name="Email Form 2" id="email-form-2" name="email-form-2">							<label class="labeldechamp" for="Courriel">Votre courriel :</label>							<input autofocus="autofocus" class="blocchamp motdepassecourriel w-input" data-name="Courriel" id="Courriel" maxlength="256" name="Courriel" required="" type="email" pattern="[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,63}$" oninvalid="setCustomValidity('Veuillez entrer une adresse courriel valide.')" onchange="try{setCustomValidity('')}catch(e){}">							<!--- <input autofocus="autofocus" class="blocchamp w-input" data-name="Courriel" id="Courriel" maxlength="256" name="Courriel" required="" type="email" pattern="[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,63}$" oninvalid="setCustomValidity('Veuillez entrer une adresse courriel valide.')" onchange="try{setCustomValidity('')}catch(e){}"> --->							<input class="boutonvalider w-button" data-wait="Veuillez patienter" name="oubli_mdp" id="oubli_mdp" type="submit" value="Envoi" wait="Veuillez patienter">						</cfform>					</div>				</div>			</div>		<CFELSE>			<div class="modalwrapper" data-ix="modal-interaction-email">				<div class="motdepassemodal"><a class="ajoutpadding lienbleu" data-ix="fermermodalemail" href="#">Close X</a>					<p class="ajouterpaddinglogin">Enter your email address and we will send you your password.</p>					<div class="w-form">						<cfform action="#file_name_en#" data-name="Email Form 2" id="email-form-2" name="email-form-2">							<label class="labeldechamp" for="Courriel">Your email address :</label>							<input autofocus="autofocus" class="blocchamp motdepassecourriel w-input" data-name="Courriel" id="Courriel" maxlength="256" name="Courriel" required="" type="email" pattern="[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,63}$" oninvalid="setCustomValidity('Enter a valid email address.')" onchange="try{setCustomValidity('')}catch(e){}">							<input class="boutonvalider w-button" data-wait="Please be patient" name="oubli_mdp" id="oubli_mdp" type="submit" value="Send" wait="Please be patient">						</cfform>					</div>				</div>			</div>		</CFIF>		<div class="w-section sectioncontenuprincipal">			<!--- <CFIF Session.langue EQ "fr">							<div class="containerselecteurlanguelogin w-container">			      			<div class="selecteurlangue w-dropdown" data-delay="0" data-hover="1">			        			<div class="containerselecteurlangue loginpage w-dropdown-toggle">			          			<div>Fran&ccedil;ais</div>			          			<div class="w-icon-dropdown-toggle"></div>			        			</div>			        			<nav class="containterparametresmenu w-dropdown-list"><a class="liselecteurlangue w-dropdown-link" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/en/home">English</a>			        			</nav>			      			</div>			    			</div>			    		<CFELSE>			    			<div class="containerselecteurlanguelogin w-container">			      			<div class="selecteurlangue w-dropdown" data-delay="0" data-hover="1">			        			<div class="containerselecteurlangue loginpage w-dropdown-toggle">			          			<div>English</div>			          			<div class="w-icon-dropdown-toggle"></div>			        			</div>			        			<nav class="containterparametresmenu w-dropdown-list"><a class="liselecteurlangue w-dropdown-link" href="<cfoutput>#APPLICATION.Racine#</cfoutput>/fr/accueil">Fran&ccedil;ais</a>			        			</nav>			      			</div>			    			</div>			    		</CFIF> --->  			<div class="w-container containerprincipal">	 			<div class="blocfondblanc fondbleu">	 				<CFIF Session.langue EQ "fr">						<img class="loginlogo" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/DDR2_blanc.png" TITLE="Logo DDR2" style="margin:10px 0px;">						<p STYLE="color:#fff;text-align:left;padding:6px;font-size:14px;">Enfin <strong>DDR2</strong>, une application web adapt&eacute;e aux besoins actuels des &eacute;glises et des organismes de bienfaisance tout en &eacute;tant facile d’acc&egrave;s, fiable et en français !</p>						<p STYLE="color:#fff;text-align:left;padding:6px;font-size:14px;">Le <strong>CQOC</strong> a travaill&eacute; &agrave; &eacute;laborer une application s&eacute;curitaire et conforme aux crit&egrave;res de l’<strong>Agence du Revenu du Canada</strong>. Ce dernier vous offre une flexibilit&eacute; dans la gestion, la compilation et les mises à jour de tous vos revenus (dons, offrandes ou autres revenus). Il vous permet &eacute;galement d’imprimer diff&eacute;rents rapports selon vos besoins tels qu’une liste des donateurs, un relev&eacute; des dons regroup&eacute;s par date, donateur ou compte. De plus, il vous permet d’imprimer vos re&ccedil;us officiels pour fins d’imp&ocirc;t en quelques secondes!</p> 						<p STYLE="color:#fff;text-align:center;padding:6px;font-size:14px;">Pour plus de d&eacute;tails concernant les services offerts par le CQOC consulter notre <b><a href="/docs/CQOC_depliant_2019.pdf" class="lienlogin" target="_blank">d&eacute;pliant pdf</b></a> ou visiter nous &agrave; <a href="https://cqoc.org/" class="lienlogin" target="_blank">https://cqoc.org</a> 							<BR><a href="/docs/CQOC_depliant_2019.pdf" class="lienlogin" target="_blank"><img src="/images/depliant.png" style="height:150px;margin-top:4px;"></a>						</p> 												<div class="w-form" >		  					<CFform action="#file_name_fr#" class="blocformulaireajouterdon" data-name="Login Form" id="login-form" name="login-form" method="POST">		  						<CFIF isDefined('Form.connexion') OR isDefined('Form.oubli_mdp')>			 						<div class="blocchamp blocchamppleinelargeur">										<div class="blocechec">				  							<div><cfoutput>#message#</cfoutput></div>										</div>			 						</div>			 					</CFIF>			 					<div class="blocchamp">									<label class="labeldechamp pagelogin" for="courriel">Courriel</label>									<input autofocus="autofocus" class="w-input champtexte" data-name="courriel" id="courriel" maxlength="100" name="courriel" required="" type="text" pattern="[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,63}$" oninvalid="setCustomValidity('Veuillez entrer une adresse courriel valide.')" onchange="try{setCustomValidity('')}catch(e){}">			 					</div>			 					<div class="blocchamp">									<label class="labeldechamp pagelogin" for="mdp">Mot de passe</label>									<input autofocus="autofocus" class="w-input champtexte" data-name="mdp" id="mdp" maxlength="256" name="mdp" required="required" type="password" pattern=".{6,}" oninvalid="setCustomValidity('Votre mot de passe doit compter au moins 6 caractères.')" onchange="try{setCustomValidity('')}catch(e){}">			 					</div>			 					<div class="blocchamp blocchamppleinelargeur">									<input class="w-button boutonvalider" name="connexion" id="connexion" data-wait="En cours de connection" type="submit" value="Se connecter" wait="En cours de connection">			 					</div>								<div class="blocchamp blocchamppleinelargeur">			 					<p class="texteblanc"><a href="#" class="lienlogin" data-ix="apparition-modal-email">J'ai oublié mon mot de passe</a>			 					</p>								</div>		  					</cfform>						</div><!--- <div class="w-form"> --->					<CFELSE>						<img class="loginlogo" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/images/DDR2_blanc.png" TITLE="DDR logo"  style="margin:10px 0px;">												<p STYLE="color:#fff;text-align:left;padding:6px;font-size:14px;">Finally <strong>DDR2</strong>, a web application adapted to the current needs of churches and charities while being easy to access and reliable!</p>						<p STYLE="color:#fff;text-align:left;padding:6px;font-size:14px;">The <strong>CQOC</strong> has worked to develop a secure application that complies with <strong>Canada Revenue Agency</strong> criteria. It offers you flexibility in the management, compilation and updates of all your income (donations, offerings or other income). It also allows you to print various reports according to your needs, such as a list of donors, a statement of donations grouped by date, donor or account. In addition, it allows you to print your official receipts for income tax purposes in a few seconds!</p> 						<p STYLE="color:#fff;text-align:center;padding:6px;font-size:14px;">For more details about the services offered by the QCCC consult our <a href="https://solution-ddr.com/docs/CQOC_depliant_2019.pdf" class="lienlogin"  target="_blank">pdf flyer (in French)</a> or visit us at <a href="https://cqoc.org" class="lienlogin"  target="_blank">https://cqoc.org</a>. 							<BR><a href="/docs/CQOC_depliant_2019.pdf" class="lienlogin" target="_blank"><img src="/images/depliant.png" style="height:150px;margin-top:4px;"></a>						</p> 												<div class="w-form" >		  					<CFform action="#file_name_en#" class="blocformulaireajouterdon" data-name="Login Form" id="login-form" name="login-form" method="POST">		  						<CFIF isDefined('Form.connexion') OR isDefined('Form.oubli_mdp')>			 						<div class="blocchamp blocchamppleinelargeur">										<div class="blocechec">				  							<div><cfoutput>#message#</cfoutput></div>										</div>			 						</div>			 					</CFIF>			 					<div class="blocchamp">									<label class="labeldechamp pagelogin" for="courriel">Email</label>									<input autofocus="autofocus" class="w-input champtexte" data-name="courriel" id="courriel" maxlength="100" name="courriel" required="" type="text" pattern="[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,63}$" oninvalid="setCustomValidity('Please enter a valid email address.')" onchange="try{setCustomValidity('')}catch(e){}">			 					</div>			 					<div class="blocchamp">									<label class="labeldechamp pagelogin" for="mdp">Password</label>									<input autofocus="autofocus" class="w-input champtexte" data-name="mdp" id="mdp" maxlength="256" name="mdp" required="required" type="password" pattern=".{6,}" oninvalid="setCustomValidity('Your password must contain at least 6 characters.')" onchange="try{setCustomValidity('')}catch(e){}">			 					</div>			 					<div class="blocchamp blocchamppleinelargeur">									<input class="w-button boutonvalider" name="connexion" id="connexion" data-wait="En cours de connection" type="submit" value="Log in" wait="Currently connection">			 					</div>								<div class="blocchamp blocchamppleinelargeur">			 					<p class="texteblanc"><a href="#" class="lienlogin" data-ix="apparition-modal-email">I forgot my password</a>			 					</p>								</div>		  					</cfform>						</div><!--- <div class="w-form"> --->					</CFIF>	 			</div><!--- <div class="blocfondblanc fondbleu"> --->  			</div><!--- <div class="w-container containerprincipal"> --->		</div><!--- <div class="w-section sectioncontenuprincipal"> --->				<CFINCLUDE TEMPLATe="_footer.inc">				<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.0/jquery.min.js"></script>		<script type="text/javascript" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/js/webflow.js"></script>		<!--[if lte IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->	</body></html>	<CFCATCH>				<CFINCLUDE TEMPLATE="_envoi_erreur.inc"> 		<CFIF Session.langue EQ "fr">			<CFLOCATION URL="#APPLICATION.Racine#/fr/erreur" ADDTOKEN="NO">		<CFELSE>			<CFLOCATION URL="#APPLICATION.Racine#/en/error" ADDTOKEN="NO">		</CFIF> 			<!--- <cfoutput>					#DateFormat(now(),"DD MMMM, YYYY")# #TimeFormat(now(),"(HH:MM:SS)")#<br>					Une erreur est survenue sur DDR					<BR>					<CFIF isDefined('Session.utilisateur.prenom')>					Utilisateur : #Session.utilisateur.prenom# #Session.utilisateur.nom# <BR>					</CFIF>					<cfif IsDefined('cfcatch')> Message : #cfcatch.Message#<BR></CFIF>															<cfif IsDefined('cfcatch')><cfdump var="#cfcatch#" label="cfcatch"></cfif>					<HR>					<cfdump var="#Form#" label="Form Variables">					<HR>					<cfdump var="#URL#" label="URL Variables">					<HR>					<cfdump var="#session#" label="Session Variables">				</cfoutput>  --->	</CFCATCH></CFTRY>