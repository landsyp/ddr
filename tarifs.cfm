<CFTRY>	<CFSET VARIABLES.title_en = "DDR RATES">	<CFSET file_name_en = "#APPLICATION.Racine#/en/rates">	<CFSET VARIABLES.title_fr = "DDR TARIFS">	<CFSET file_name_fr = "#APPLICATION.Racine#/fr/tarifs">		<!DOCTYPE html>	<!-- This site was created in Webflow. http://www.webflow.com-->	<!-- Last Published: Thu Jun 16 2016 16:27:16 GMT+0000 (UTC) -->	<html data-wf-site="5718896fb6f10eb45d8c7872" data-wf-page="5731981ac809f1bc5f09caa4">		<head>			<CFINCLUDE TEMPLATe="_head.inc">		</head>		<body>			<CFINCLUDE TEMPLATe="_menu.inc">			  			<div class="w-section sectioncontenuprincipal">  			    			<div class="w-container containerprincipal">      			<div class="blockfondblancpageinterne">      				        				<CFIF session.langue EQ "fr">        					<h2>Co&ucirc;t d'utilisation</h2>        					<div class="lignedetableau headertableau">          					<div class="itemligne "><strong>Revenus de l'organisme*</strong></div>          					<div class="itemligne"><strong>Taux membre CQOC**</strong></div>          					<div class="itemligne"><strong>Taux non-membre CQOC</strong></div>        					</div>        					<div class="lignedetableau" >          					<div class="itemligne">0 &agrave; $50,000</div>          					<div class="itemligne">$60/ann&eacute;e</div>          					<div class="itemligne">$70/ann&eacute;e</div>          				</div>							<div class="lignedetableau" >          					<div class="itemligne">$50,001 et plus</div>          					<div class="itemligne">$70/ann&eacute;e</div>          					<div class="itemligne">$85/ann&eacute;e</div>          				</div>          				<div class="lignedetableau" STYLE="justify-content:left;text-align:left;" >          					<div class="itemligne">* Le revenu total est obtenu selon la ligne 4700 de la derni&egrave;re T3010 sur le site de l'Agence du Revenu du Canada.</div>							</div>							<div class="lignedetableau" STYLE="justify-content:left;text-align:left;" >								<div class="itemligne">** Si vous désirez adhérer comme membre au CQOC afin de profiter de ce rabais et de bénéficier de nombreux avantages, veuillez contacter Manon Coupal au (450) 778-7177 poste 122.</div>							</div>							<div class="lignedetableau" STYLE="justify-content:left;text-align:left;" >								<div class="itemligne">Si vous avez le DDR et que vous aimeriez faire transf&eacute;rer votre base de donn&eacute;es sur le nouveau DDR2, veuillez contacter Manon Coupal au (450) 778-7177 au poste 122.</div>							</div>							<h2>Re&ccedil;us DDR2</h2>							Faits exclusivement pour le logiciel DDR2, les reçus de 8.5 X 14, pré numérotés et pré perforésen 4 copies<br> 							(3 copies pour le donateur et 1 copie pour l'organisme)							<div class="lignedetableau headertableau">          					<div class="itemligne "><strong>Quantit&eacute;</strong></div>          					<div class="itemligne"><strong>Co&ucirc;t</strong></div>        					</div>        					<div class="lignedetableau" >          					<div class="itemligne">50</div>          					<div class="itemligne">$45 + $18*</div>          				</div>          				<div class="lignedetableau" >          					<div class="itemligne">500</div>          					<div class="itemligne">$70 + $20*</div>          				</div>          				<div class="lignedetableau" >          					<div class="itemligne">1000</div>          					<div class="itemligne">$120 + $26*</div>          				</div>          				<div class="lignedetableau" STYLE="justify-content:left;text-align:left;" >          					<div class="itemligne">* Frais de transport et manutention</div>							</div>          				        				<CFELSE>        				        					<div class="lignedetableau headertableau">          					<div class="itemligne"><strong>Yearly Income*</strong></div>          					<div class="itemligne"><strong>CQOC Member Fee**</strong></div>          					<div class="itemligne"><strong>CQOC Non-Member Fee</strong></div>        					</div>        					<div class="lignedetableau" >          					<div class="itemligne">0 to $50,000</div>          					<div class="itemligne">$60/year</div>          					<div class="itemligne">$70/year</div>          				</div>							<div class="lignedetableau" >          					<div class="itemligne">$50,001 +</div>          					<div class="itemligne">$70/year</div>          					<div class="itemligne">$85/year</div>          				</div>        					<div class="lignedetableau" STYLE="justify-content:left;text-align:left;" >          					<div class="itemligne">* The total revenue is according to line 4700 on the last T3010 on the Canada Revenue Agency web site.</div>							</div>							<div class="lignedetableau" STYLE="justify-content:left;text-align:left;" >								<div class="itemligne">** If you wish to become a member of the QCCC  and to take advantage of the many benefits, contact Manon Coupal at (450) 778-7177, extension 122.</div>							</div>							<div class="lignedetableau" STYLE="justify-content:left;text-align:left;" >								<div class="itemligne">If you already have the old version of the DDR and you would like to have your database transferred to DDR2, contact Manon Coupal at (450)778-7177, extension 122.</div>							</div>							<h2>DDR2 Receipts</h2>							Made exclusively for DDR2 software, receipts are 8.5 X 14, pre numbered and pre perforated to produce 4 copies <br>							(3 for donor & 1 for the charity)							<div class="lignedetableau headertableau">          					<div class="itemligne "><strong>Quantity</strong></div>          					<div class="itemligne"><strong>Cost</strong></div>        					</div>        					<div class="lignedetableau" >          					<div class="itemligne">50</div>          					<div class="itemligne">$45 + $18*</div>          				</div>          				<div class="lignedetableau" >          					<div class="itemligne">500</div>          					<div class="itemligne">$70 + $20*</div>          				</div>          				<div class="lignedetableau" >          					<div class="itemligne">1000</div>          					<div class="itemligne">$120 + $26*</div>          				</div>          				<div class="lignedetableau" STYLE="justify-content:left;text-align:left;" >          					<div class="itemligne">* Cost for shipping and handling</div>							</div>        				</CFIF>      			</div>    			</div>  			</div>		  			<CFINCLUDE TEMPLATe="_footer.inc">					<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.0/jquery.min.js"></script>			<script type="text/javascript" src="<cfoutput>#APPLICATION.Racine#</cfoutput>/js/webflow.js"></script>			<!--[if lte IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->			</body>	</html>	<CFCATCH>				<CFINCLUDE TEMPLATE="_envoi_erreur.inc"> 		<CFIF Session.langue EQ "fr">			<CFLOCATION URL="#APPLICATION.Racine#/fr/erreur" ADDTOKEN="NO">		<CFELSE>			<CFLOCATION URL="#APPLICATION.Racine#/en/error" ADDTOKEN="NO">		</CFIF>		<!--- <cfoutput>					#DateFormat(now(),"DD MMMM, YYYY")# #TimeFormat(now(),"(HH:MM:SS)")#<br>					Une erreur est survenue sur DDR					<BR>					<CFIF isDefined('Session.utilisateur.prenom')>					Utilisateur : #Session.utilisateur.prenom# #Session.utilisateur.nom# <BR>					</CFIF>					<cfif IsDefined('cfcatch')> Message : #cfcatch.Message#<BR></CFIF>																	<cfif IsDefined('cfcatch')><cfdump var="#cfcatch#" label="cfcatch"></cfif>					<HR>					<cfdump var="#Form#" label="Form Variables">					<HR>					<cfdump var="#URL#" label="URL Variables">					<HR>					<cfdump var="#session#" label="Session Variables">				</cfoutput> --->			</CFCATCH></CFTRY>