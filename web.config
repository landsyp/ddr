<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<system.webServer>
		<defaultDocument>
			<files>
				<clear />
				<add value="index.cfm" />
				<add value="index.htm" /> 
			</files>
		</defaultDocument>
		<rewrite>
			<rules>
				<rule name="Redirect to https" stopProcessing="true">
                    <match url=".*" />
                    <conditions>
                        <add input="{HTTPS}" pattern="off" ignoreCase="true" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
                </rule>
				
				<!-- ACCUEIL -->
				<rule name="maintenance fr"> 
					<match url="^fr/entretien?$" />
					<action type="Rewrite" url="maintenance.cfm?langue=fr" />
				</rule>
				<rule name="maintenance en"> 
					<match url="^en/maintenance?$" />
					<action type="Rewrite" url="maintenance.cfm?langue=en" />
				</rule>
				<rule name="test fr">
					<match url="^fr/test?$" />
					<action type="Rewrite" url="_utilisateurs/_test.cfm?langue=fr" />
				</rule>
				 
				<rule name="accueil fr">
					<match url="^fr/accueil?$" />
					<action type="Rewrite" url="index.cfm?langue=fr" />
				</rule>
				<rule name="accueil en">
					<match url="^en/home?$" />
					<action type="Rewrite" url="index.cfm?langue=en" />
				</rule>
				<rule name="erreur fr">
					<match url="^fr/erreur?$" />
					<action type="Rewrite" url="erreur.cfm?langue=fr" />
				</rule>
				<rule name="erreur en">
					<match url="^en/error?$" />
					<action type="Rewrite" url="erreur.cfm?langue=en" />
				</rule>
				<rule name="conditions fr">
					<match url="^fr/conditions-utilisation?$" />
					<action type="Rewrite" url="conditions.cfm?langue=fr" />
				</rule>
				<rule name="conditions en">
					<match url="^en/terms-of-use?$" />
					<action type="Rewrite" url="conditions.cfm?langue=en" />
				</rule>
				
				<rule name="abonnement fr">
					<match url="^fr/abonnement?$" />
					<action type="Rewrite" url="abonnement.cfm?langue=fr" />
				</rule>
				<rule name="abonnement en">
					<match url="^en/subscription?$" />
					<action type="Rewrite" url="abonnement.cfm?langue=en" />
				</rule>
				<rule name="tarifs fr">
					<match url="^fr/tarifs?$" />
					<action type="Rewrite" url="tarifs.cfm?langue=fr" />
				</rule>
				<rule name="tarifs en">
					<match url="^en/rates?$" />
					<action type="Rewrite" url="tarifs.cfm?langue=en" />
				</rule>
				
				<!-- ADMIN -->
				<rule name="admin ajout organisme fr">
					<match url="^fr/secure/admin-ajout-organisme?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organisme.cfm?langue=fr" />
				</rule>
				<rule name="admin ajout organisme en">
					<match url="^en/secure/admin-add-charity?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organisme.cfm?langue=en" />
				</rule>
				<rule name="admin organisme editer fr">
					<match url="^fr/secure/admin-editer-organisme-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organisme.cfm?OID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="admin organisme editer en">
					<match url="^en/secure/admin-edit-charity-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organisme.cfm?OID={R:1}&amp;langue=en" />
				</rule>
				<rule name="admin organismes liste fr">
					<match url="^fr/secure/admin-liste-organismes/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste.cfm?page={R:1}&amp;langue=fr" />
				</rule>
				<rule name="admin organismes liste en">
					<match url="^en/secure/admin-charities-list/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste.cfm?page={R:1}&amp;langue=en" />
				</rule>
				<rule name="admin organismes liste excel fr">
					<match url="^fr/secure/admin-liste-organismes-excel?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste_excel.cfm?langue=fr" />
				</rule>
				<rule name="admin organismes liste excel en">
					<match url="^en/secure/admin-charities-list-excel?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste_excel.cfm?langue=en" />
				</rule>
				<rule name="admin organisme archiver fr">
					<match url="^fr/secure/admin-archiver-organisme-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste.cfm?archiverOID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="admin organisme archiver en">
					<match url="^en/secure/admin-archive-charity-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste.cfm?archiverOID={R:1}&amp;langue=en" />
				</rule>
				<rule name="admin organisme activer fr">
					<match url="^fr/secure/admin-activer-organisme-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste.cfm?activerOID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="admin organisme activer en">
					<match url="^en/secure/admin-activate-charity-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste.cfm?activerOID={R:1}&amp;langue=en" />
				</rule>
				<rule name="admin envoi mdp utilisateur fr">
					<match url="^fr/secure/admin-envoi-utilisateur-org([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste.cfm?envoiOID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="admin envoi mdp utilisateur en">
					<match url="^en/secure/admin-send-user-org([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin_organismes_liste.cfm?envoiOID={R:1}&amp;langue=en" />
				</rule>
				<rule name="admin ajout utilisateur fr">
					<match url="^fr/secure/admin-ajout-utilisateur-org([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin-utilisateur.cfm?oid={R:1}&amp;langue=fr" />
				</rule>
				<rule name="admin ajout utilisateur en">
					<match url="^en/secure/admin-add-user-org([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin-utilisateur.cfm?oid={R:1}&amp;langue=en" />
				</rule>
				<rule name="admin utilisateur editer fr">
					<match url="^fr/secure/admin-editer-utilisateur-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin-utilisateur.cfm?UID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="admin utilisateur editer en">
					<match url="^en/secure/admin-edit-user-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/admin-utilisateur.cfm?UID={R:1}&amp;langue=en" />
				</rule>
				
				
				<!-- ZONE SECURISEE -->
				<rule name="secure accueil fr">  
					<match url="^fr/secure/accueil?$" />
					<action type="Rewrite" url="_utilisateurs/index.cfm?langue=fr" />
				</rule>
				<rule name="secure accueil en">
					<match url="^en/secure/home?$" />
					<action type="Rewrite" url="_utilisateurs/index.cfm?langue=en" />
				</rule>
				<rule name="secure tutorials fr">
					<match url="^fr/secure/tutoriels?$" />
					<action type="Rewrite" url="_utilisateurs/tutorials.cfm?langue=fr" />
				</rule>
				<rule name="secure tutorials en">
					<match url="^en/secure/tutorials?$" />
					<action type="Rewrite" url="_utilisateurs/tutorials.cfm?langue=en" />
				</rule>
				<!-- UTILSATEURS -->
				<rule name="utilisateurs liste fr">
					<match url="^fr/secure/liste-des-utilisateurs/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateurs_liste.cfm?page={R:1}&amp;langue=fr" />
				</rule>
				<rule name="utilisateurs liste en">
					<match url="^en/secure/users-list/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateurs_liste.cfm?page={R:1}&amp;langue=en" />
				</rule>
				<rule name="utilisateur archiver fr">
					<match url="^fr/secure/archiver-utilisateur-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateurs_liste.cfm?archiverUID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="utilisateur archiver en">
					<match url="^en/secure/archive-user-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateurs_liste.cfm?archiverUID={R:1}&amp;langue=en" />
				</rule>
				<rule name="utilisateur activer fr">
					<match url="^fr/secure/activer-utilisateur-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateurs_liste.cfm?activerUID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="utilisateur activer en">
					<match url="^en/secure/activate-user-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateurs_liste.cfm?activerUID={R:1}&amp;langue=en" />
				</rule>
				<rule name="utilisateur supprimer fr">
					<match url="^fr/secure/supprimer-utilisateur-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateurs_liste.cfm?supprimerUID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="utilisateur supprimer en">
					<match url="^en/secure/delete-user-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateurs_liste.cfm?supprimerUID={R:1}&amp;langue=en" />
				</rule>
				<rule name="utilisateur ajout fr">
					<match url="^fr/secure/ajout-utilisateur?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateur.cfm?langue=fr" />
				</rule>
				<rule name="utilisateur ajout en">
					<match url="^en/secure/add-user?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateur.cfm?langue=en" />
				</rule>
				<rule name="utilisateur editer fr">
					<match url="^fr/secure/editer-utilisateur-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateur.cfm?UID={R:1}&amp;langue=fr" />
				</rule>
				<rule name="utilisateur editer en">
					<match url="^en/secure/edit-user-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/utilisateur.cfm?UID={R:1}&amp;langue=en" />
				</rule>
				<rule name="deconnexion fr">
					<match url="^fr/deconnexion?$" />
					<action type="Rewrite" url="index.cfm?langue=fr&amp;logout" />
				</rule>
				<rule name="deconnexion en">
					<match url="^en/logout?$" />
					<action type="Rewrite" url="index.cfm?langue=en&amp;logout" />
				</rule>
				<!-- DONS -->
				<rule name="dons liste tri fr">
					<match url="^fr/secure/liste-des-dons/tri-([^/]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste.cfm?tri={R:1}&amp;page={R:2}&amp;langue=fr" />
				</rule>
				# test #
				<rule name="dons liste tri test fr">
					<match url="^fr/secure/liste-des-dons-test/tri-([^/]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste_test.cfm?tri={R:1}&amp;page={R:2}&amp;langue=fr" />
				</rule>
				<rule name="dons liste tri en">
					<match url="^en/secure/gifts-list/sort-([^/]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste.cfm?tri={R:1}&amp;page={R:2}&amp;langue=en" />
				</rule>
				<rule name="dons liste tri test en">
					<match url="^en/secure/gifts-list-test/sort-([^/]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste_test.cfm?tri={R:1}&amp;page={R:2}&amp;langue=en" />
				</rule>
				<rule name="dons liste fr">
					<match url="^fr/secure/liste-des-dons/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste.cfm?page={R:1}&amp;langue=fr" />
				</rule>
				# test #
				<rule name="dons liste test fr">
					<match url="^fr/secure/liste-des-dons-test/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste_test.cfm?page={R:1}&amp;langue=fr" />
				</rule>
				<rule name="dons liste en">
					<match url="^en/secure/gifts-list/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste.cfm?page={R:1}&amp;langue=en" />
				</rule>
				<rule name="dons liste test en">
