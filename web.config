				<rule name="donateur ajout tri fr">
					<match url="^fr/secure/ajout-donateur/tri-([^/]+)?$" />
					<action type="Rewrite" url="_utilisateurs/donateur.cfm?tri={R:1}&amp;langue=fr" />
				</rule>
				<rule name="donateur ajout tri en">
					<match url="^en/secure/add-donor/sort-([^/]+)?$" />
					<action type="Rewrite" url="_utilisateurs/donateur.cfm?tri={R:1}&amp;langue=en" />
				</rule>
				<rule name="donateur ajout fr">
					<match url="^fr/secure/ajout-donateur?$" />
					<action type="Rewrite" url="_utilisateurs/donateur.cfm?langue=fr" />
				</rule>
				<rule name="donateur ajout en">
