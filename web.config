				<rule name="donateurs batch fr">
					<match url="^fr/secure/import-donateurs-lot?$" />
					<action type="Rewrite" url="_utilisateurs/donateurs-batch.cfm?langue=fr" />
				</rule>
				<rule name="donateurs batch en">
					<match url="^en/secure/donors-batch-import?$" />
