					<action type="Rewrite" url="_utilisateurs/rapport_envois_courriel.cfm?excel=1&amp;langue=en" />
				</rule> 
				<!-- LISTE GROUPEE PAR DATE D'ENVOI -->
				<rule name="rapport envois recus liste fr">
