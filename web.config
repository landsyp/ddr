					<action type="Rewrite" url="_utilisateurs/dons_liste_test.cfm?page={R:1}&amp;langue=en" />
				</rule>
				<rule name="dons liste excel fr">
					<match url="^fr/secure/liste-des-dons-excel?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste.cfm?excel=1&amp;langue=fr" />
				</rule>
				<rule name="dons liste excel en">
