					<action type="Rewrite" url="_utilisateurs/rapport_envois_courriel.cfm?langue=en" />
				</rule>
				<!-- RAPPORT RECUS EXCEL -->
				<rule name="rapport envois courriels excel fr">
					<match url="^fr/secure/rapport-envois-excel?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_envois_courriel.cfm?excel=1&amp;langue=fr" />
				</rule>
				<rule name="rapport envois courriels excel en">
