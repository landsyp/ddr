				</rule>
				<rule name="rapport envoi recus info tri page fr">
					<match url="^fr/secure/info-sur-envoi-([0-9-]+)/tri-([^/]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/envoi_info.cfm?envoiCode={R:1}&amp;tri={R:2}&amp;page={R:3}&amp;langue=fr" />
				</rule>
				<rule name="rapport envoi recus info sort page en">
					<match url="^en/secure/bulk-emails-info-([0-9-]+)/sort-([^/]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/envoi_info.cfm?envoiCode={R:1}&amp;tri={R:2}&amp;page={R:3}&amp;langue=en" />
				</rule>
				<rule name="rapport envoi recus info page fr">
					<match url="^fr/secure/info-sur-envoi-([0-9-]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/envoi_info.cfm?envoiCode={R:1}&amp;page={R:2}&amp;langue=fr" />
				</rule>
				<rule name="rapport envoi recus info page en">
					<match url="^en/secure/bulk-emails-info-([0-9-]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/envoi_info.cfm?envoiCode={R:1}&amp;page={R:2}&amp;langue=en" />
				</rule>
				<rule name="rapport envoi recus info fr">
					<match url="^fr/secure/info-sur-envoi-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/envoi_info.cfm?envoiCode={R:1}&amp;page=1&amp;langue=fr" />
				</rule>
				<rule name="rapport envoi recus info en">
					<match url="^en/secure/bulk-emails-info-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/envoi_info.cfm?envoiCode={R:1}&amp;page=1&amp;langue=en" />
				</rule>
				
				
				<!-- PARAMETRES -->
				<rule name="profil fr">
					<match url="^fr/secure/parametres-profil?$" />
					<action type="Rewrite" url="_utilisateurs/profil.cfm?langue=fr" />
				</rule>
				<rule name="profil en">
					<match url="^en/secure/parameters-profile?$" />
					<action type="Rewrite" url="_utilisateurs/profil.cfm?langue=en" />
				</rule>
				<!-- ROUTINES -->
				<rule name="routine alerte license">
					<match url="^alerte/expiration-license?$" />
					<action type="Rewrite" url="routines/alerte_expiration_license.cfm" />
				</rule>
				<!-- MIGRATION -->
				<rule name="migration comptes">
					<match url="^migration/comptes?$" />
					<action type="Rewrite" url="migration/transfertComptes.cfm" />
				</rule>
				<rule name="migration donateurs">
					<match url="^migration/donateurs?$" />
					<action type="Rewrite" url="migration/transfertDonateurs.cfm" />
				</rule>
				<rule name="migration dons">
					<match url="^migration/dons?$" />
					<action type="Rewrite" url="migration/transfertDons.cfm" />
				</rule>
				<rule name="migration utilisateurs">
					<match url="^migration/utilisateurs?$" />
					<action type="Rewrite" url="migration/transfertUtilisateurs.cfm" />
				</rule>
				<!-- EXPORT -->
				<rule name="export index">
					<match url="^export/?$" />
					<action type="Rewrite" url="export/index.cfm" />
				</rule>
				<rule name="export comptes">
					<match url="^export/comptes?$" />
					<action type="Rewrite" url="export/exportComptes.cfm" />
				</rule>
				<rule name="export donateurs">
					<match url="^export/donateurs?$" />
					<action type="Rewrite" url="export/exportDonateurs.cfm" />
				</rule>
				<rule name="export dons">
					<match url="^export/dons?$" />
					<action type="Rewrite" url="export/exportDons.cfm" />
				</rule>
				<rule name="export utilisateurs">
					<match url="^export/utilisateurs?$" />
					<action type="Rewrite" url="export/exportUtilisateurs.cfm" />
				</rule>
				
				<rule name="cfc donateurs">
					<match url="^cfc/donateurs?$" />
					<action type="Rewrite" url="cfc/donateurs.cfc" />
				</rule>
				<rule name="cfc comptes">
					<match url="^cfc/comptes?$" />
					<action type="Rewrite" url="cfc/comptes.cfc" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
</configuration>
