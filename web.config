					<action type="Rewrite" url="_utilisateurs/rapport_dons-sommaire_test.cfm?langue=fr" />
				</rule>
				<rule name="rapport dons sommaire test en">
					<match url="^en/secure/report-gifts-summary/test?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_dons-sommaire_test.cfm?langue=en" />
				</rule>
				
				<rule name="rapport donateurs fr">
					<match url="^fr/secure/rapport-donateurs?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_donateurs.cfm?langue=fr" />
				</rule>
				<rule name="rapport donateurs en">
					<match url="^en/secure/report-donors?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_donateurs.cfm?langue=en" />
				</rule>
				<rule name="rapport comptes fr">
					<match url="^fr/secure/rapport-comptes?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_comptes.cfm?langue=fr" />
