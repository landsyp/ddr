				</rule>
				<rule name="rapport envois courriels tri en">
					<match url="^en/secure/report-bulk-emails/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_envois_courriel.cfm?page={R:1}&amp;langue=en" />
				</rule>
				<rule name="rapport envois courriels fr">
