				</rule>
				
				#################################
				#####	RECUS IMPOT			#####
				#################################
				<rule name="rapport recus test fr">
					<match url="^fr/secure/rapport-recus-test?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_recus_test.cfm?langue=fr" />
				</rule>
				<rule name="rapport recus test en">
					<match url="^en/secure/report-receipts-test?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_recus_test.cfm?langue=en" />
				</rule>
				
				#####	RECUS PDF		#####
				<!-- GENERATEUR DE RECUS -->
				<rule name="generateur recus fr">
					<match url="^fr/secure/rapport-recus?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_recus.cfm?langue=fr" />
				</rule>
				<rule name="generateur recus en">
					<match url="^en/secure/report-receipts?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_recus.cfm?langue=en" />
				</rule>
				<!-- RAPPORT DE RECUS HTML -->
				<rule name="rapport recus tri page fr">
					<match url="^fr/secure/rapport-impression-pdf/tri-([^/]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_impression_pdf.cfm?tri={R:1}&amp;page={R:2}&amp;langue=fr" />
				</rule>
				<rule name="rapport recus tri page en">
					<match url="^en/secure/report-pdf-printing/sort-([^/]+)/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_impression_pdf.cfm?tri={R:1}&amp;page={R:2}&amp;langue=en" />
				</rule>
				<rule name="rapport recus page fr">
					<match url="^fr/secure/rapport-impression-pdf/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_impression_pdf.cfm?page={R:1}&amp;langue=fr" />
				</rule>
				<rule name="rapport recus page en">
					<match url="^en/secure/report-pdf-printing/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_impression_pdf.cfm?page={R:1}&amp;langue=en" />
				</rule>
				<rule name="rapport recus fr">
					<match url="^fr/secure/rapport-impression-pdf?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_impression_pdf.cfm?langue=fr" />
				</rule>
				<rule name="rapport recus en">
					<match url="^en/secure/report-pdf-printing?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_impression_pdf.cfm?langue=en" />
				</rule>
				<!-- RAPPORT DE RECUS EXCEL -->
				<rule name="rapport recus excel fr">
					<match url="^fr/secure/rapport-impression-excel?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_impression_pdf.cfm?excel=1&amp;langue=fr" />
				</rule>
				<rule name="rapport recus excel en">
					<match url="^en/secure/report-excel-printing?$" />
					<action type="Rewrite" url="_utilisateurs/rapport_impression_pdf.cfm?excel=1&amp;langue=en" />
				</rule>
				<!-- RAPPORT DE RECUS GROUPES PAR DATE DE PRODUCTION HTML -->
				<rule name="rapport impression pdf liste fr">
					<match url="^fr/secure/liste-impressions-pdf/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/impressions_liste.cfm?page={R:1}&amp;langue=fr" />
				</rule> 
				<rule name="rapport impression pdf liste en">
					<match url="^en/secure/pdf-printing-list/page-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/impressions_liste.cfm?page={R:1}&amp;langue=en" />
				</rule>
				
				
				##### 	ENVOIS COURRIELS 	#####
				<rule name="rapport recus courriels fr">
					<match url="^fr/secure/generateur-recus-courriels?$" />
					<action type="Rewrite" url="_utilisateurs/generateur_recus_courriels.cfm?langue=fr" />
