				</rule>
				<rule name="dons liste quickbooks en">
					<match url="^en/secure/gifts-list-quickbooks?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste.cfm?quickbooks=1&amp;langue=en" />
				</rule>
				<rule name="don supprimer fr">
					<match url="^fr/secure/supprimer-don-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste.cfm?supprimerDID={R:1}&amp;page=1&amp;langue=fr" />
				</rule>
				<rule name="don supprimer en">
					<match url="^en/secure/delete-gift-([0-9-]+)?$" />
					<action type="Rewrite" url="_utilisateurs/dons_liste.cfm?supprimerDID={R:1}&amp;page=1&amp;langue=en" />
				</rule>
				<rule name="don ajout tri fr">
					<match url="^fr/secure/ajout-don/tri-([^/]+)?$" />
					<action type="Rewrite" url="_utilisateurs/don.cfm?tri={R:1}&amp;langue=fr" />
				</rule>
				<rule name="don ajout tri en">
					<match url="^en/secure/add-gift/sort-([^/]+)?$" />
					<action type="Rewrite" url="_utilisateurs/don.cfm?tri={R:1}&amp;langue=en" />
				</rule>
				<rule name="don ajout fr">
